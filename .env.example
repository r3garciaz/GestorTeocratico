# Environment variables for the PostgreSQL database service
POSTGRES_DB=exampledb
POSTGRES_PORT=5432
POSTGRES_USER=exampleuser
POSTGRES_PASSWORD=examplepassword

# Connection string for the .NET application
CONNECTIONSTRINGS__DEFAULTCONNECTION="Host=database;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"

##Email Server Configuration
RESEND__APITOKEN="xxxxxx"
RESEND__FROMEMAIL="Gestor Teocratico <delivered@resend.dev>"

##Emergency local admin account (break-glass, used when Google sign-in is unavailable)
AUTHENTICATION__SCHEMES__GOOGLEOIDC__CLIENTID="xxxxxx.apps.googleusercontent.com"
AUTHENTICATION__SCHEMES__GOOGLEOIDC__CLIENTSECRET="xxxxxx"
EMERGENCYADMIN__EMAIL="admin@example.com"
EMERGENCYADMIN__PASSWORD="change-me-strong-password"
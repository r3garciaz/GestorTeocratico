@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Datos personales</PageTitle>

<h2 class="mb-4 text-xl font-semibold">Datos personales</h2>
<StatusMessage/>

<div class="max-w-xl space-y-4">
    <p class="text-sm text-muted-foreground">
        Tu cuenta contiene datos personales que nos has proporcionado. Esta página te permite
        descargar o eliminar esos datos.
    </p>
    <p class="text-sm font-medium text-destructive">
        Eliminar estos datos eliminará permanentemente tu cuenta y no se podrá recuperar.
    </p>

    <div class="flex flex-wrap gap-3">
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken/>
            <BbButton Type="BlazorBlueprint.Components.ButtonType.Submit" Variant="ButtonVariant.Outline">
                <Icon><LucideIcon Name="download"/></Icon>
                <ChildContent>Descargar</ChildContent>
            </BbButton>
        </form>
        <BbButton Href="Account/Manage/DeletePersonalData" Variant="ButtonVariant.Destructive">
            <Icon><LucideIcon Name="trash-2"/></Icon>
            <ChildContent>Eliminar</ChildContent>
        </BbButton>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}

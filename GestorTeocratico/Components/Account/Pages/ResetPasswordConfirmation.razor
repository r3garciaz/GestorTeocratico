@page "/Account/ResetPasswordConfirmation"

@using BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components

<PageTitle>Contraseña restablecida</PageTitle>

<AuthCard Title="Contraseña restablecida" Description="Ya puedes iniciar sesión con tu nueva contraseña." Icon="circle-check">
    <div class="text-center">
        <BbButton Href="Account/Login" Class="w-full">
            <Icon><LucideIcon Name="log-in"/></Icon>
            <ChildContent>Iniciar sesión</ChildContent>
        </BbButton>
    </div>
</AuthCard>

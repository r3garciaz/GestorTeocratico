@page "/Account/Lockout"

<PageTitle>Cuenta bloqueada</PageTitle>

<AuthCard Title="Cuenta bloqueada" Description="Esta cuenta ha sido bloqueada. Inténtalo de nuevo más tarde." Icon="lock">
    <p class="text-sm text-muted-foreground">
        Si crees que es un error, contacta con tu administrador.
    </p>
    <div class="text-center">
        <BbButton Href="/Account/Login" Variant="ButtonVariant.Outline" Class="w-full">
            <ChildContent>Volver al inicio de sesión</ChildContent>
        </BbButton>
    </div>
</AuthCard>

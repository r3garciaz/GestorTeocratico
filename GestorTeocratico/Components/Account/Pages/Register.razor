@page "/Account/Register"

@using BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components

<PageTitle>Crear cuenta</PageTitle>

@*
    Registro Google-only: la cuenta se crea automáticamente (auto-provisionado) al
    iniciar sesión con Google y verificar el correo. No hay registro público con
    contraseña.
*@

<AuthCard Title="Crea tu cuenta" Description="Usamos tu cuenta de Google para crear tu cuenta de forma segura." Icon="user-plus">
    <ExternalLoginPicker/>

    <p class="text-center text-sm text-muted-foreground">
        Al continuar, se creará tu cuenta con tu correo verificado de Google.
    </p>

    <div class="text-center text-sm">
        <a href="Account/Login" class="text-muted-foreground underline underline-offset-4 hover:text-foreground">
            ¿Ya tienes cuenta? Inicia sesión
        </a>
    </div>
</AuthCard>

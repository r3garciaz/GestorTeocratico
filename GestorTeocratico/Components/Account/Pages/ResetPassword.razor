@page "/Account/ResetPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components

@inject UserManager<ApplicationUser> UserManager
@inject ILogger<ResetPassword> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>Restablecer contraseña</PageTitle>

<AuthCard Title="Restablecer contraseña" Description="Elige una nueva contraseña para tu cuenta." Icon="key-round">
    <StatusMessage Message="@Message"/>

    <EditForm Model="Input" method="post" OnValidSubmit="ResetUserPassword" FormName="reset-password" class="space-y-4">
        <DataAnnotationsValidator/>
        <ValidationSummary class="text-sm text-destructive" role="alert"/>
        <div class="space-y-2">
            <BbLabel For="Input.Email">Correo electrónico</BbLabel>
            <InputText @bind-Value="Input.Email" id="Input.Email" class="@InputClass"
                       placeholder="name@example.com" autocomplete="username" required/>
            <ValidationMessage For="() => Input.Email" class="text-sm text-destructive"/>
        </div>
        <div class="space-y-2">
            <BbLabel For="Input.Password">Nueva contraseña</BbLabel>
            <InputText @bind-Value="Input.Password" id="Input.Password" type="password" class="@InputClass"
                       autocomplete="new-password" required/>
            <ValidationMessage For="() => Input.Password" class="text-sm text-destructive"/>
        </div>
        <div class="space-y-2">
            <BbLabel For="Input.ConfirmPassword">Confirmar contraseña</BbLabel>
            <InputText @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" type="password" class="@InputClass"
                       autocomplete="new-password" required/>
            <ValidationMessage For="() => Input.ConfirmPassword" class="text-sm text-destructive"/>
        </div>
        <BbButton Type="BlazorBlueprint.Components.ButtonType.Submit" Class="w-full">
            <ChildContent>Restablecer contraseña</ChildContent>
        </BbButton>
    </EditForm>

    <div class="text-center text-sm">
        <a href="Account/Login" class="text-muted-foreground underline underline-offset-4 hover:text-foreground">
            Volver al inicio de sesión
        </a>
    </div>
</AuthCard>

@code {
    private const string InputClass =
        "flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm " +
        "placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring";

    public string? Message { get; set; }

    [SupplyParameterFromForm] public InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery] public string? Code { get; set; }

    protected override void OnInitialized()
    {
        Logger.LogInformation("ResetPassword page loaded.");
        if (Code is null)
        {
            Message = "Solicitud de restablecimiento no válida.";
            return;
        }
        Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
    }

    public async Task ResetUserPassword()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            Message = "Si el correo existe, se procesará el restablecimiento.";
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        Message = result.Succeeded
            ? "Tu contraseña se restableció correctamente."
            : string.Join(", ", result.Errors.Select(e => e.Description));
    }

    public class InputModel
    {
        [Required] [EmailAddress] public string Email { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessage = "La contraseña debe tener entre {2} y {1} caracteres.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "La contraseña y la confirmación no coinciden.")]
        public string ConfirmPassword { get; set; } = "";

        [Required] public string Code { get; set; } = "";
    }
}

@using Microsoft.AspNetCore.Identity
@using GestorTeocratico.Data

@inject SignInManager<ApplicationUser> SignInManager

<nav class="flex flex-col gap-1 text-sm">
    <NavLink href="Account/Manage" Match="NavLinkMatch.All"
             class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
             ActiveClass="bg-accent text-foreground font-medium">
        Perfil
    </NavLink>
    <NavLink href="Account/Manage/Email"
             class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
             ActiveClass="bg-accent text-foreground font-medium">
        Correo
    </NavLink>
    <NavLink href="Account/Manage/ChangePassword"
             class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
             ActiveClass="bg-accent text-foreground font-medium">
        Contraseña
    </NavLink>
    @if (hasExternalLogins)
    {
        <NavLink href="Account/Manage/ExternalLogins"
                 class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
                 ActiveClass="bg-accent text-foreground font-medium">
            Inicios de sesión externos
        </NavLink>
    }
    <NavLink href="Account/Manage/TwoFactorAuthentication"
             class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
             ActiveClass="bg-accent text-foreground font-medium">
        Autenticación de dos factores
    </NavLink>
    <NavLink href="Account/Manage/PersonalData"
             class="rounded-md px-3 py-2 text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
             ActiveClass="bg-accent text-foreground font-medium">
        Datos personales
    </NavLink>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}

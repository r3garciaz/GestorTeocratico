<StatusMessage Message="@StatusMessage"/>

<h3 class="text-lg font-semibold">Códigos de recuperación</h3>

<div class="rounded-md border border-amber-500/30 bg-amber-500/10 p-4 text-sm text-amber-700">
    <p class="font-medium">Guarda estos códigos en un lugar seguro.</p>
    <p class="mt-1">
        Si pierdes el dispositivo y no tienes los códigos, perderás el acceso a tu cuenta.
    </p>
</div>

<div class="grid gap-1 rounded-md border bg-muted/40 p-4 font-mono text-sm">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <code>@recoveryCode</code>
    }
</div>

@code {
    [Parameter] public string[] RecoveryCodes { get; set; } = [];

    [Parameter] public string? StatusMessage { get; set; }
}

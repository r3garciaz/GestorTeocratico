@page "/"
@layout Layout.IndexLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@using BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components
@using ButtonSize = BlazorBlueprint.Components.ButtonSize

@*
    Landing pública (Fase 2). Página estática: se usan solo componentes de BB que
    renderizan en SSR (botones como enlaces, cards, tipografía, iconos).
*@

<PageTitle>Gestor Teocrático</PageTitle>

<div class="container space-y-20 py-16 lg:py-24">

    <!-- Hero -->
    <section class="mx-auto max-w-3xl space-y-8 text-center">
        <div class="flex justify-center">
            <BbBadge Variant="BadgeVariant.Secondary" class="px-3 py-1">
                <LucideIcon Name="sparkles" Class="mr-1 size-3.5"/>
                Organiza tu congregación, sin hojas de cálculo
            </BbBadge>
        </div>

        <div class="space-y-4">
            <BbTypographyH1 Class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
                Todo tu servicio, <span class="text-primary">bien organizado</span>
            </BbTypographyH1>
            <BbTypographyLead Class="mx-auto max-w-2xl text-muted-foreground">
                Gestiona publicadores, departamentos, responsabilidades y la programación de
                reuniones en un solo lugar. Acceso seguro con tu cuenta de Google.
            </BbTypographyLead>
        </div>

        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <BbButton Href="/Account/Login" Size="ButtonSize.Large">
                <Icon><LucideIcon Name="log-in"/></Icon>
                <ChildContent>Continuar con Google</ChildContent>
            </BbButton>
            <BbButton Href="#features" Variant="ButtonVariant.Outline" Size="ButtonSize.Large">
                <Icon><LucideIcon Name="arrow-down"/></Icon>
                <ChildContent>Ver funciones</ChildContent>
            </BbButton>
        </div>
    </section>

    <!-- Features -->
    <section id="features" class="mx-auto max-w-5xl space-y-10">
        <div class="space-y-4 text-center">
            <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
                Todo lo que tu congregación necesita
            </h2>
            <BbTypographyLead Class="mx-auto max-w-2xl text-muted-foreground">
                Herramientas pensadas para simplificar la organización y la programación de reuniones.
            </BbTypographyLead>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var feature in Features)
            {
                <BbCard>
                    <BbCardHeader>
                        <div class="mb-3 flex size-10 items-center justify-center rounded-full bg-primary/10 text-primary">
                            <LucideIcon Name="@feature.Icon" Class="size-5"/>
                        </div>
                        <BbCardTitle>@feature.Title</BbCardTitle>
                    </BbCardHeader>
                    <BbCardContent>
                        <BbTypographyP Class="text-muted-foreground">@feature.Description</BbTypographyP>
                    </BbCardContent>
                </BbCard>
            }
        </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-5xl">
        <div class="rounded-xl bg-primary p-8 text-center text-primary-foreground md:p-16">
            <div class="mx-auto max-w-2xl space-y-6">
                <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">¿Listo para empezar?</h2>
                <p class="text-lg text-primary-foreground/80">
                    Entra con tu cuenta de Google y comienza a organizar tu congregación hoy.
                </p>
                <div class="flex items-center justify-center">
                    <BbButton Href="/Account/Login" Size="ButtonSize.Large" Variant="ButtonVariant.Secondary">
                        <Icon><LucideIcon Name="log-in"/></Icon>
                        <ChildContent>Continuar con Google</ChildContent>
                    </BbButton>
                </div>
            </div>
        </div>
    </section>

</div>

@code {
    private sealed record Feature(string Icon, string Title, string Description);

    private static readonly Feature[] Features =
    [
        new("users", "Publicadores",
            "Directorio centralizado con datos de contacto, privilegios y responsabilidades."),
        new("building-2", "Departamentos",
            "Organiza departamentos, sus responsables y las responsabilidades asociadas."),
        new("clipboard-list", "Responsabilidades",
            "Define y asigna responsabilidades de forma clara y reutilizable."),
        new("calendar-days", "Programación de reuniones",
            "Programa semanas, asigna responsabilidades y copia programaciones fácilmente."),
        new("file-text", "Exportación a PDF",
            "Genera documentos listos para imprimir y compartir con la congregación."),
        new("shield-check", "Acceso seguro",
            "Inicio de sesión con Google y control de acceso por roles (Admin, Manager, Usuario)."),
    ];
}

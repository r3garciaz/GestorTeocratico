@page "/ui-preview"
@attribute [AllowAnonymous]
@using BlazorBlueprint.Components
@inject ToastService Toasts

@*
    Página temporal de la Fase 0 para VALIDAR el renderizado de Blazor Blueprint
    dentro de este proyecto (interactividad por página + islas interactivas del layout).

    Comprueba:
      - Estilos base (Tailwind + blazorblueprint.css) y tokens del tema.
      - Componentes interactivos (botones, inputs, switch, tabs).
      - Overlays portaled (BbDialog, BbTooltip, BbDropdownMenu) → requieren BbPortalHost.
      - Toasts (BbToastProvider + ToastService).
    Eliminar cuando la migración de UI esté completa.
*@

<PageTitle>UI Preview - Blazor Blueprint</PageTitle>

<div class="container py-12">
    <div class="mx-auto max-w-4xl space-y-12">

        <section class="space-y-3 text-center">
            <BbBadge Variant="BadgeVariant.Secondary">Fase 0 · validación de renderizado</BbBadge>
            <h1 class="text-4xl font-bold tracking-tight">Blazor Blueprint funcionando</h1>
            <p class="mx-auto max-w-2xl text-muted-foreground">
                Si ves estilos, colores del tema y los componentes interactivos funcionando,
                la fundación está lista para empezar a migrar el shell (Fase 1).
            </p>
        </section>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Componentes básicos</BbCardTitle>
                <BbCardDescription>Botones, badges e inputs.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent Class="space-y-6">
                <div class="flex flex-wrap gap-2">
                    <BbButton>Primary</BbButton>
                    <BbButton Variant="ButtonVariant.Secondary">Secondary</BbButton>
                    <BbButton Variant="ButtonVariant.Outline">Outline</BbButton>
                    <BbButton Variant="ButtonVariant.Ghost">Ghost</BbButton>
                    <BbButton Variant="ButtonVariant.Destructive">Destructive</BbButton>
                    <BbButton Loading="true" LoadingText="Guardando...">Guardar</BbButton>
                </div>

                <div class="flex flex-wrap gap-2">
                    <BbBadge>Default</BbBadge>
                    <BbBadge Variant="BadgeVariant.Secondary">Secondary</BbBadge>
                    <BbBadge Variant="BadgeVariant.Outline">Outline</BbBadge>
                    <BbBadge Variant="BadgeVariant.Destructive">Destructive</BbBadge>
                </div>

                <div class="space-y-2">
                    <BbLabel For="demo-input">Campo de texto</BbLabel>
                    <BbInput id="demo-input" Placeholder="Escribe algo..." @bind-Value="inputValue"
                             UpdateTiming="UpdateTiming.Immediate"/>
                    @if (!string.IsNullOrEmpty(inputValue))
                    {
                        <p class="text-sm text-muted-foreground">Escribiste: @inputValue</p>
                    }
                </div>

                <div class="flex items-center gap-6">
                    <div class="flex items-center gap-2">
                        <BbSwitch id="sw" @bind-Checked="toggleOn"/>
                        <BbLabel For="sw" Class="font-normal">Switch (@(toggleOn ? "on" : "off"))</BbLabel>
                    </div>
                    <div class="flex items-center gap-2">
                        <BbCheckbox id="cb" @bind-Checked="checkedOn"/>
                        <BbLabel For="cb" Class="font-normal">Checkbox</BbLabel>
                    </div>
                </div>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Overlays y notificaciones</BbCardTitle>
                <BbCardDescription>Requieren el BbPortalHost montado como isla interactiva.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent Class="flex flex-wrap gap-2">
                <BbDialog @bind-Open="dialogOpen">
                    <BbDialogTrigger>
                        <BbButton Variant="ButtonVariant.Outline">Abrir diálogo</BbButton>
                    </BbDialogTrigger>
                    <BbDialogContent>
                        <BbDialogHeader>
                            <BbDialogTitle>Diálogo portaled</BbDialogTitle>
                            <BbDialogDescription>
                                Se renderiza vía BbPortalHost, con focus trap y cierre con Escape.
                            </BbDialogDescription>
                        </BbDialogHeader>
                        <BbDialogFooter>
                            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => dialogOpen = false)">Cancelar</BbButton>
                            <BbButton OnClick="@(() => dialogOpen = false)">Continuar</BbButton>
                        </BbDialogFooter>
                    </BbDialogContent>
                </BbDialog>

                <BbTooltip>
                    <BbTooltipTrigger AsChild="true">
                        <BbButton Variant="ButtonVariant.Outline">Tooltip</BbButton>
                    </BbTooltipTrigger>
                    <BbTooltipContent>Posicionado con Floating UI</BbTooltipContent>
                </BbTooltip>

                <BbDropdownMenu>
                    <BbDropdownMenuTrigger AsChild="true">
                        <BbButton Variant="ButtonVariant.Outline">Menú</BbButton>
                    </BbDropdownMenuTrigger>
                    <BbDropdownMenuContent>
                        <BbDropdownMenuItem>Perfil</BbDropdownMenuItem>
                        <BbDropdownMenuItem>Ajustes</BbDropdownMenuItem>
                        <BbDropdownMenuSeparator/>
                        <BbDropdownMenuItem Variant="DropdownMenuItemVariant.Destructive">Salir</BbDropdownMenuItem>
                    </BbDropdownMenuContent>
                </BbDropdownMenu>

                <BbButton OnClick="ShowToast">Mostrar toast</BbButton>
            </BbCardContent>
        </BbCard>

    </div>
</div>

@code {
    private string? inputValue;
    private bool toggleOn = true;
    private bool checkedOn;
    private bool dialogOpen;

    private void ShowToast() => Toasts.Success(
        "Los toasts se encolan vía ToastService y se renderizan con BbToastProvider.",
        "Toast de prueba");
}

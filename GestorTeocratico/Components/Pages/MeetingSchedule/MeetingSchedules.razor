@page "/meeting-schedules"
@attribute [Authorize(Roles = "Admin, Manager")]
@using System.Globalization
@using GestorTeocratico.Features.MeetingSchedules
@using GestorTeocratico.Features.Responsibilities
@using GestorTeocratico.Shared.Enums
@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Icons.Lucide.Components
@using ButtonSize = BlazorBlueprint.Components.ButtonSize

@inject NavigationManager NavigationManager
@inject GetAllMeetingSchedulesHandler GetAllSchedules
@inject GetOrCreateWeekSchedulesHandler GetOrCreateWeek
@inject CopyWeekAssignmentsHandler CopyWeek
@inject GetAssignmentsByMeetingScheduleHandler GetAssignments
@inject AssignResponsibilityHandler AssignResponsibility
@inject UnassignResponsibilityHandler UnassignResponsibility
@inject GetResponsibilitiesHandler GetResponsibilities
@inject GetResponsibilityOptionsHandler GetResponsibilityOptions
@inject ToastService Toasts

<PageTitle>Programación de Responsabilidades</PageTitle>

<div class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Programación de responsabilidades</h1>
            <p class="text-sm text-muted-foreground">Asigna publicadores a cada responsabilidad por semana.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <BbSelect TValue="string" Options="_viewOptions" @bind-Value="_selectedViewType" @bind-Value:after="LoadDataAsync"
                      Class="w-[170px]"/>
            @if (_selectedViewType != "list" && _weeklySchedules.Count > 0)
            {
                <BbButton Variant="ButtonVariant.Outline" OnClick="ExportToPdf" Disabled="_exportingPdf">
                    <Icon><LucideIcon Name="file-down"/></Icon>
                    <ChildContent>Exportar PDF</ChildContent>
                </BbButton>
            }
            <BbButton Variant="ButtonVariant.Outline" OnClick="OpenCopyWeek">
                <Icon><LucideIcon Name="copy"/></Icon>
                <ChildContent>Copiar semana</ChildContent>
            </BbButton>
            <BbButton OnClick="LoadDataAsync">
                <Icon><LucideIcon Name="refresh-cw"/></Icon>
                <ChildContent>Actualizar</ChildContent>
            </BbButton>
        </div>
    </div>

    @if (_selectedViewType == "week")
    {
        <div class="flex flex-wrap items-end gap-4">
            <div class="space-y-2">
                <BbLabel>Año</BbLabel>
                <BbNumericInput TValue="int" Min="2020" Max="2030" Class="w-28"
                                @bind-Value="_selectedYear" @bind-Value:after="LoadDataAsync"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Semana</BbLabel>
                <BbNumericInput TValue="int" Min="1" Max="53" Class="w-28"
                                @bind-Value="_selectedWeek" @bind-Value:after="LoadDataAsync"/>
            </div>
            <p class="pb-2 text-sm font-medium text-muted-foreground">@GetWeekDateRange()</p>
        </div>
    }
    else if (_selectedViewType == "month")
    {
        <div class="flex flex-wrap items-end gap-4">
            <div class="space-y-2">
                <BbLabel>Año</BbLabel>
                <BbNumericInput TValue="int" Min="2020" Max="2030" Class="w-28"
                                @bind-Value="_selectedYear" @bind-Value:after="LoadDataAsync"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Mes</BbLabel>
                <BbNumericInput TValue="int" Min="1" Max="12" Class="w-28"
                                @bind-Value="_selectedMonth" @bind-Value:after="LoadDataAsync"/>
            </div>
            <p class="pb-2 text-sm font-medium text-muted-foreground">@GetMonthName()</p>
        </div>
    }

    @if (_weeklySchedules.Count == 0)
    {
        <BbCard>
            <BbCardContent Class="py-10 text-center text-sm text-muted-foreground">
                No hay programaciones para el período seleccionado.
            </BbCardContent>
        </BbCard>
    }
    else
    {
        <div class="min-w-0 overflow-x-auto">
        <BbDataTable TData="WeeklyScheduleDto" Data="@_weeklySchedules" InitialPageSize="10"
                     ShowPagination="false" AriaLabel="Programación">
            <Columns>
                <BbDataTableColumn TData="WeeklyScheduleDto" TValue="string" Id="week" Property="@(w => w.WeekDisplay)"
                                   Header="Semana" Width="130px">
                    <CellTemplate Context="w">
                        <div class="text-center font-medium">
                            <div>Sem. @w.WeekOfYear</div>
                            <div class="text-xs text-muted-foreground">@w.DateRange</div>
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="WeeklyScheduleDto" TValue="MeetingType" Id="type" Property="@(w => w.MeetingType)"
                                   Header="Reunión" Width="120px">
                    <CellTemplate Context="w">
                        <BbBadge Variant="@(w.MeetingType == MeetingType.Midweek ? BadgeVariant.Default : BadgeVariant.Secondary)">
                            @(w.MeetingType == MeetingType.Midweek ? "Entre semana" : "Fin de semana")
                        </BbBadge>
                    </CellTemplate>
                </BbDataTableColumn>
                @foreach (var responsibility in _responsibilities)
                {
                    <BbDataTableColumn TData="WeeklyScheduleDto" TValue="string"
                                       Id="@responsibility.Id.ToString()"
                                       Header="@responsibility.Name" Width="170px">
                        <CellTemplate Context="w">
                            @{
                                var assignment = w.Assignments.FirstOrDefault(a => a.ResponsibilityId == responsibility.Id);
                            }
                            @if (assignment is not null)
                            {
                                <BbButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Class="w-full"
                                          OnClick="@(() => OpenAssignmentAsync(w, responsibility))">
                                    <ChildContent>@assignment.PublisherName</ChildContent>
                                </BbButton>
                            }
                            else
                            {
                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                          Class="w-full text-muted-foreground"
                                          OnClick="@(() => OpenAssignmentAsync(w, responsibility))">
                                    <Icon><LucideIcon Name="plus"/></Icon>
                                    <ChildContent>Asignar</ChildContent>
                                </BbButton>
                            }
                        </CellTemplate>
                    </BbDataTableColumn>
                }
            </Columns>
        </BbDataTable>
        </div>
    }
</div>

@* ===== Asignar responsabilidad ===== *@
<BbDialog @bind-Open="_assignOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@_assignResponsibility?.Name</BbDialogTitle>
            <BbDialogDescription>@_assignSubtitle</BbDialogDescription>
        </BbDialogHeader>

        @if (_assignLoading)
        {
            <p class="py-4 text-center text-sm text-muted-foreground">Cargando…</p>
        }
        else
        {
            @if (_currentAssignment is not null)
            {
                <div class="flex items-center justify-between rounded-md bg-muted px-3 py-2">
                    <span class="text-sm">@_currentAssignment.PublisherName</span>
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Quitar asignación"
                              OnClick="RemoveAssignmentAsync">
                        <LucideIcon Name="x" Class="size-4 text-destructive"/>
                    </BbButton>
                </div>
            }
            else
            {
                <p class="text-sm text-muted-foreground">No hay publicador asignado.</p>
            }

            <div class="space-y-2">
                <BbLabel>@(_currentAssignment is null ? "Asignar publicador" : "Cambiar publicador")</BbLabel>
                @if (_publisherOptions.Length == 0)
                {
                    <p class="text-xs text-muted-foreground">No hay publicadores habilitados para esta responsabilidad.</p>
                }
                else
                {
                    <BbSelect TValue="Guid?" Options="_publisherOptions"
                              @bind-Value="_selectedPublisherId" Placeholder="Selecciona un publicador"/>
                }
            </div>
        }

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _assignOpen = false)">
                <ChildContent>Cancelar</ChildContent>
            </BbButton>
            <BbButton OnClick="SaveAssignmentAsync" Disabled="@_assignLoading">
                <ChildContent>Guardar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@* ===== Copiar semana ===== *@
<BbDialog @bind-Open="_copyOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Copiar asignaciones de semana</BbDialogTitle>
            <BbDialogDescription>Copia las asignaciones de una semana a otra.</BbDialogDescription>
        </BbDialogHeader>

        @if (!string.IsNullOrEmpty(_copyError))
        {
            <div class="rounded-md border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive">
                @_copyError
            </div>
        }

        <div class="grid grid-cols-2 gap-4">
            <div class="space-y-2">
                <BbLabel>Semana origen</BbLabel>
                <BbNumericInput TValue="int" Min="1" Max="53" Class="w-full" @bind-Value="_sourceWeek"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Año origen</BbLabel>
                <BbNumericInput TValue="int" Min="2020" Max="2030" Class="w-full" @bind-Value="_sourceYear"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Semana destino</BbLabel>
                <BbNumericInput TValue="int" Min="1" Max="53" Class="w-full" @bind-Value="_targetWeek"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Año destino</BbLabel>
                <BbNumericInput TValue="int" Min="2020" Max="2030" Class="w-full" @bind-Value="_targetYear"/>
            </div>
        </div>
        <p class="text-xs text-muted-foreground">
            Origen: @GetWeekDateRange(_sourceWeek, _sourceYear) · Destino: @GetWeekDateRange(_targetWeek, _targetYear)
        </p>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _copyOpen = false)">
                <ChildContent>Cancelar</ChildContent>
            </BbButton>
            <BbButton OnClick="CopyWeekAsync">
                <ChildContent>Copiar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private readonly SelectOption<string>[] _viewOptions =
    [
        new("week", "Por semana"),
        new("month", "Por mes"),
        new("list", "Lista completa")
    ];

    private string _selectedViewType = "month";
    private int _selectedYear = DateTime.Now.Year;
    private int _selectedWeek = ISOWeek.GetWeekOfYear(DateTime.Now);
    private int _selectedMonth = DateTime.Now.Month;
    private bool _exportingPdf;

    private List<ResponsibilityDto> _responsibilities = [];
    private List<WeeklyScheduleDto> _weeklySchedules = [];

    // Assignment dialog
    private bool _assignOpen;
    private bool _assignLoading;
    private WeeklyScheduleDto? _assignWeek;
    private ResponsibilityDto? _assignResponsibility;
    private AssignmentDto? _currentAssignment;
    private SelectOption<Guid?>[] _publisherOptions = [];
    private Guid? _selectedPublisherId;

    // Copy dialog
    private bool _copyOpen;
    private int _sourceWeek = ISOWeek.GetWeekOfYear(DateTime.Now);
    private int _sourceYear = DateTime.Now.Year;
    private int _targetWeek = ISOWeek.GetWeekOfYear(DateTime.Now) + 1;
    private int _targetYear = DateTime.Now.Year;
    private string? _copyError;

    private string _assignSubtitle => _assignWeek is null
        ? ""
        : $"Semana {_assignWeek.WeekOfYear}, {_assignWeek.Year} · " +
          (_assignWeek.MeetingType == MeetingType.Midweek ? "Reunión entre semana" : "Reunión de fin de semana");

    protected override async Task OnInitializedAsync()
    {
        _responsibilities = (await GetResponsibilities.HandleAsync()).ToList();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            List<MeetingScheduleDto> schedules = _selectedViewType switch
            {
                "week" => (await GetOrCreateWeek.HandleAsync(
                    new GetOrCreateWeekSchedulesQuery(_selectedWeek, _selectedYear))).ToList(),
                "month" => await LoadMonthDataAsync(),
                _ => (await GetAllSchedules.HandleAsync()).ToList()
            };

            _weeklySchedules = schedules
                .OrderBy(ms => ms.WeekOfYear)
                .ThenBy(ms => ms.MeetingType)
                .Select(ms => new WeeklyScheduleDto
                {
                    MeetingScheduleId = ms.Id,
                    WeekOfYear = ms.WeekOfYear,
                    Year = ms.Year,
                    MeetingType = ms.MeetingType,
                    DateRange = GetWeekDateRange(ms.WeekOfYear, ms.Year),
                    WeekDisplay = $"Semana {ms.WeekOfYear}",
                    Assignments = ms.Assignments.ToList()
                })
                .ToList();
        }
        catch
        {
            Toasts.Error("No se pudieron cargar los datos.", "Error");
        }
    }

    private async Task<List<MeetingScheduleDto>> LoadMonthDataAsync()
    {
        var result = new List<MeetingScheduleDto>();
        var firstDay = new DateTime(_selectedYear, _selectedMonth, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);

        var startWeek = ISOWeek.GetWeekOfYear(firstDay);
        var endWeek = ISOWeek.GetWeekOfYear(lastDay);

        if (_selectedMonth == 1 && startWeek > 50) startWeek = 1;
        else if (_selectedMonth == 12 && endWeek < 10) endWeek = ISOWeek.GetWeeksInYear(_selectedYear);

        for (var week = startWeek; week <= endWeek; week++)
        {
            try
            {
                var weekSchedules = await GetOrCreateWeek.HandleAsync(
                    new GetOrCreateWeekSchedulesQuery(week, _selectedYear));
                result.AddRange(weekSchedules.Where(ws => ws.Month == _selectedMonth && ws.Year == _selectedYear));
            }
            catch
            {
                // Skip weeks that fail.
            }
        }

        return result.OrderBy(ms => ms.Date).ToList();
    }

    private async Task OpenAssignmentAsync(WeeklyScheduleDto week, ResponsibilityDto responsibility)
    {
        _assignWeek = week;
        _assignResponsibility = responsibility;
        _assignLoading = true;
        _assignOpen = true;
        _currentAssignment = null;
        _selectedPublisherId = null;
        _publisherOptions = [];

        var assignments = await GetAssignments.HandleAsync(new GetAssignmentsByMeetingScheduleQuery(week.MeetingScheduleId));
        _currentAssignment = assignments.FirstOrDefault(a => a.ResponsibilityId == responsibility.Id);
        _selectedPublisherId = _currentAssignment?.PublisherId;

        var eligibleIds = responsibility.PublisherIds.ToHashSet();
        var options = await GetResponsibilityOptions.HandleAsync();
        _publisherOptions = options.Publishers
            .Where(p => eligibleIds.Contains(p.Id))
            .Select(p => new SelectOption<Guid?>(p.Id, p.Name))
            .OrderBy(o => o.Text)
            .ToArray();

        _assignLoading = false;
    }

    private async Task SaveAssignmentAsync()
    {
        if (_assignWeek is null || _assignResponsibility is null)
        {
            return;
        }

        try
        {
            if (_currentAssignment is not null)
            {
                await UnassignResponsibility.HandleAsync(new UnassignResponsibilityCommand(
                    _currentAssignment.MeetingScheduleId, _currentAssignment.ResponsibilityId, _currentAssignment.PublisherId));
            }

            if (_selectedPublisherId.HasValue)
            {
                await AssignResponsibility.HandleAsync(new AssignResponsibilityCommand(
                    _assignWeek.MeetingScheduleId, _assignResponsibility.Id, _selectedPublisherId.Value));
            }

            Toasts.Success("Asignación guardada.", "Guardado");
            _assignOpen = false;
            await LoadDataAsync();
        }
        catch
        {
            Toasts.Error("No se pudo guardar la asignación.", "Error");
        }
    }

    private async Task RemoveAssignmentAsync()
    {
        if (_currentAssignment is null)
        {
            return;
        }

        try
        {
            await UnassignResponsibility.HandleAsync(new UnassignResponsibilityCommand(
                _currentAssignment.MeetingScheduleId, _currentAssignment.ResponsibilityId, _currentAssignment.PublisherId));
            Toasts.Success("Asignación eliminada.", "Guardado");
            _assignOpen = false;
            await LoadDataAsync();
        }
        catch
        {
            Toasts.Error("No se pudo eliminar la asignación.", "Error");
        }
    }

    private void OpenCopyWeek()
    {
        _copyError = null;
        _copyOpen = true;
    }

    private async Task CopyWeekAsync()
    {
        _copyError = null;

        if (_sourceYear == _targetYear && _sourceWeek == _targetWeek)
        {
            _copyError = "La semana origen y destino no pueden ser la misma.";
            return;
        }
        if (_sourceYear is < 2020 or > 2030 || _targetYear is < 2020 or > 2030 ||
            _sourceWeek is < 1 or > 53 || _targetWeek is < 1 or > 53)
        {
            _copyError = "Semana (1-53) o año (2020-2030) fuera de rango.";
            return;
        }

        try
        {
            await CopyWeek.HandleAsync(new CopyWeekAssignmentsCommand(
                _sourceWeek, _sourceYear, _targetWeek, _targetYear));

            Toasts.Success("Asignaciones copiadas.", "Guardado");
            _copyOpen = false;
            await LoadDataAsync();
        }
        catch
        {
            _copyError = "No se pudieron copiar las asignaciones.";
        }
    }

    private void ExportToPdf()
    {
        _exportingPdf = true;

        // The export endpoint is monthly. In week view, export the month that contains
        // the selected week; in month view, the selected month.
        var year = _selectedYear;
        var month = _selectedMonth;
        if (_selectedViewType == "week")
        {
            var monday = ISOWeek.ToDateTime(_selectedYear, _selectedWeek, DayOfWeek.Monday);
            year = monday.Year;
            month = monday.Month;
        }

        var url = $"/api/meeting-schedules/monthly-schedule/{year}/{month}";
        NavigationManager.NavigateTo(url, forceLoad: true);
    }

    private string GetWeekDateRange() => GetWeekDateRange(_selectedWeek, _selectedYear);

    private static string GetWeekDateRange(int week, int year)
    {
        try
        {
            var monday = ISOWeek.ToDateTime(year, week, DayOfWeek.Monday);
            return $"{monday:dd/MM} - {monday.AddDays(6):dd/MM/yyyy}";
        }
        catch
        {
            return "Fecha inválida";
        }
    }

    private string GetMonthName()
    {
        var culture = new CultureInfo("es-ES");
        return $"{culture.DateTimeFormat.GetMonthName(_selectedMonth)} {_selectedYear}";
    }

    public class WeeklyScheduleDto
    {
        public Guid MeetingScheduleId { get; set; }
        public int WeekOfYear { get; set; }
        public int Year { get; set; }
        public MeetingType MeetingType { get; set; }
        public string DateRange { get; set; } = string.Empty;
        public string WeekDisplay { get; set; } = string.Empty;
        public List<AssignmentDto> Assignments { get; set; } = [];
    }
}

@page "/congregations"
@attribute [Authorize(Roles = "Admin, Manager")]
@implements IDisposable
@using GestorTeocratico.Features.Common
@using GestorTeocratico.Features.Congregations
@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Icons.Lucide.Components

@inject GetCongregationsHandler GetCongregations
@inject CreateCongregationHandler CreateCongregation
@inject UpdateCongregationHandler UpdateCongregation
@inject ToastService Toasts

<PageTitle>Congregación</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Congregación</h1>
        <p class="text-sm text-muted-foreground">Datos y días de reunión de la congregación.</p>
    </div>

    <BbCard Class="max-w-3xl">
        <BbCardHeader>
            <BbCardTitle>Detalles de la congregación</BbCardTitle>
            <BbCardDescription>Configura el nombre, la dirección y los días de reunión.</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <EditForm Model="_congregation" OnValidSubmit="SaveAsync" class="space-y-4">
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="space-y-2 sm:col-span-2">
                        <BbLabel For="Name">Nombre *</BbLabel>
                        <BbInput Id="Name" @bind-Value="_congregation.Name" Placeholder="Nombre de la congregación"/>
                    </div>

                    <div class="space-y-2">
                        <BbLabel>Reunión entre semana (año par)</BbLabel>
                        <BbSelect TValue="DayOfWeek" Options="_days"
                                  @bind-Value="_congregation.MidweekMeetingDayEvenYear"/>
                    </div>
                    <div class="space-y-2">
                        <BbLabel>Reunión entre semana (año impar)</BbLabel>
                        <BbSelect TValue="DayOfWeek" Options="_days"
                                  @bind-Value="_congregation.MidweekMeetingDayOddYear"/>
                    </div>
                    <div class="space-y-2">
                        <BbLabel>Reunión fin de semana (año par)</BbLabel>
                        <BbSelect TValue="DayOfWeek" Options="_days"
                                  @bind-Value="_congregation.WeekendMeetingDayEvenYear"/>
                    </div>
                    <div class="space-y-2">
                        <BbLabel>Reunión fin de semana (año impar)</BbLabel>
                        <BbSelect TValue="DayOfWeek" Options="_days"
                                  @bind-Value="_congregation.WeekendMeetingDayOddYear"/>
                    </div>

                    <div class="space-y-2 sm:col-span-2">
                        <BbLabel For="Address">Dirección</BbLabel>
                        <BbInput Id="Address" @bind-Value="_congregation.Address" Placeholder="Dirección"/>
                    </div>
                    <div class="space-y-2 sm:col-span-2">
                        <BbLabel For="City">Ciudad</BbLabel>
                        <BbInput Id="City" @bind-Value="_congregation.City" Placeholder="Ciudad"/>
                    </div>
                </div>

                <div class="flex justify-end">
                    <BbButton Type="BlazorBlueprint.Components.ButtonType.Submit">
                        <Icon><LucideIcon Name="save"/></Icon>
                        <ChildContent>Guardar</ChildContent>
                    </BbButton>
                </div>
            </EditForm>
        </BbCardContent>
    </BbCard>
</div>

@code {
    private CongregationFormModel _congregation = new() { Name = string.Empty };
    private bool _isNew;
    private readonly CancellationTokenSource _cts = new();

    private readonly SelectOption<DayOfWeek>[] _days =
    [
        new(DayOfWeek.Monday, "Lunes"),
        new(DayOfWeek.Tuesday, "Martes"),
        new(DayOfWeek.Wednesday, "Miércoles"),
        new(DayOfWeek.Thursday, "Jueves"),
        new(DayOfWeek.Friday, "Viernes"),
        new(DayOfWeek.Saturday, "Sábado"),
        new(DayOfWeek.Sunday, "Domingo")
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var first = (await GetCongregations.HandleAsync(_cts.Token)).FirstOrDefault();
            if (first is null)
            {
                _congregation = new CongregationFormModel { Name = string.Empty };
                _isNew = true;
            }
            else
            {
                _congregation = first.ToFormModel();
                _isNew = false;
            }
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_congregation.Name))
        {
            Toasts.Error("El nombre es obligatorio.", "Error");
            return;
        }

        try
        {
            if (_isNew)
            {
                await CreateCongregation.HandleAsync(new CreateCongregationCommand(
                    _congregation.Name,
                    _congregation.MidweekMeetingDayEvenYear,
                    _congregation.MidweekMeetingDayOddYear,
                    _congregation.WeekendMeetingDayEvenYear,
                    _congregation.WeekendMeetingDayOddYear,
                    _congregation.Address,
                    _congregation.City));

                _isNew = false;
                Toasts.Success("Congregación creada.", "Guardado");
            }
            else
            {
                await UpdateCongregation.HandleAsync(new UpdateCongregationCommand(
                    _congregation.Id,
                    _congregation.Name,
                    _congregation.MidweekMeetingDayEvenYear,
                    _congregation.MidweekMeetingDayOddYear,
                    _congregation.WeekendMeetingDayEvenYear,
                    _congregation.WeekendMeetingDayOddYear,
                    _congregation.Address,
                    _congregation.City));

                Toasts.Success("Congregación actualizada.", "Guardado");
            }
        }
        catch (DuplicateEntityException ex)
        {
            Toasts.Warning(ex.Message, "Atención");
        }
        catch
        {
            Toasts.Error("No se pudo guardar la congregación.", "Error");
        }
    }
}

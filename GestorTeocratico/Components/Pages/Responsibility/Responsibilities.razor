@page "/responsibilities"
@attribute [Authorize(Roles = "Admin, Manager")]
@using System.Globalization
@using GestorTeocratico.Features.Common
@using GestorTeocratico.Features.Responsibilities
@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Icons.Lucide.Components
@using ButtonSize = BlazorBlueprint.Components.ButtonSize

@inject GetResponsibilitiesHandler GetResponsibilities
@inject GetResponsibilityByIdHandler GetResponsibilityById
@inject GetResponsibilityOptionsHandler GetResponsibilityOptions
@inject CreateResponsibilityHandler CreateResponsibility
@inject UpdateResponsibilityHandler UpdateResponsibility
@inject DeleteResponsibilityHandler DeleteResponsibility

<PageTitle>Responsabilidades</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Responsabilidades</h1>
        <p class="text-sm text-muted-foreground">Responsabilidades por departamento y publicadores asignados.</p>
    </div>

    <BbDataTable TData="ResponsibilityDto" Data="@_responsibilities" InitialPageSize="10" AriaLabel="Responsabilidades">
        <ToolbarActions>
            <BbButton OnClick="OpenCreate">
                <Icon><LucideIcon Name="plus"/></Icon>
                <ChildContent>Agregar responsabilidad</ChildContent>
            </BbButton>
        </ToolbarActions>
        <Columns>
            <BbDataTableColumn TData="ResponsibilityDto" TValue="string" Property="@(r => r.Name)"
                               Header="Nombre" Sortable="true" Filterable="true"/>
            <BbDataTableColumn TData="ResponsibilityDto" TValue="string" Property="@(r => r.Description)"
                               Header="Descripción" Filterable="true">
                <CellTemplate Context="r">
                    @if (!string.IsNullOrEmpty(r.Description))
                    {
                        <span>@(r.Description.Length > 60 ? $"{r.Description[..60]}…" : r.Description)</span>
                    }
                    else
                    {
                        <span class="text-muted-foreground">—</span>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ResponsibilityDto" TValue="string" Header="Departamento" Width="180px">
                <CellTemplate Context="r">
                    @if (r.DepartmentName is not null)
                    {
                        <span>@r.DepartmentName</span>
                    }
                    else
                    {
                        <span class="text-muted-foreground">Sin departamento</span>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ResponsibilityDto" TValue="string" Header="Publicadores asignados" Width="240px">
                <CellTemplate Context="r">
                    <EntityChips Items="@r.PublisherNames"/>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ResponsibilityDto" TValue="string" Header="Acciones" Width="150px">
                <CellTemplate Context="r">
                    <div class="flex items-center gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Ver"
                                  OnClick="@(() => OpenDetails(r))">
                            <LucideIcon Name="eye" Class="size-4"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Editar"
                                  OnClick="@(() => OpenEdit(r))">
                            <LucideIcon Name="pencil" Class="size-4"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Eliminar"
                                  OnClick="@(() => OpenDelete(r))">
                            <LucideIcon Name="trash-2" Class="size-4 text-destructive"/>
                        </BbButton>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</div>

@* ===== Formulario crear/editar ===== *@
<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>@(_isNew ? "Agregar responsabilidad" : "Editar responsabilidad")</BbDialogTitle>
            <BbDialogDescription>Define la responsabilidad, su departamento y publicadores.</BbDialogDescription>
        </BbDialogHeader>

        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="rounded-md border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive">
                @_formError
            </div>
        }

        <EditForm Model="_editing" OnValidSubmit="SaveAsync" class="space-y-4">
            <div class="space-y-2">
                <BbLabel For="Name">Nombre *</BbLabel>
                <BbInput Id="Name" @bind-Value="_editing.Name" Placeholder="Nombre de la responsabilidad"/>
            </div>
            <div class="space-y-2">
                <BbLabel For="Description">Descripción</BbLabel>
                <BbTextarea Id="Description" @bind-Value="_editing.Description" Placeholder="Descripción (opcional)" Rows="3"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Departamento</BbLabel>
                <BbSelect TValue="Guid?" Options="_departmentOptions"
                          @bind-Value="_editing.DepartmentId" Placeholder="Sin departamento"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Publicadores asignados</BbLabel>
                <BbMultiSelect TValue="Guid" Options="_publisherOptions" MaxDisplayTags="5" SingleLine="true"
                               Values="_selectedPublishers" ValuesChanged="OnPublishersChanged" Placeholder="Selecciona publicadores"/>
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _formOpen = false)">
                    <ChildContent>Cancelar</ChildContent>
                </BbButton>
                <BbButton Type="BlazorBlueprint.Components.ButtonType.Submit">
                    <ChildContent>Guardar</ChildContent>
                </BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@* ===== Confirmar eliminación ===== *@
<BbDialog @bind-Open="_deleteOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Eliminar responsabilidad</BbDialogTitle>
            <BbDialogDescription>
                ¿Seguro que deseas eliminar <strong>@_deleteTarget?.Name</strong>? Esta acción no se puede deshacer.
            </BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _deleteOpen = false)">
                <ChildContent>Cancelar</ChildContent>
            </BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmDeleteAsync">
                <ChildContent>Eliminar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@* ===== Detalles ===== *@
<BbDialog @bind-Open="_detailsOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@_detailsTarget?.Name</BbDialogTitle>
            <BbDialogDescription>Detalles de la responsabilidad.</BbDialogDescription>
        </BbDialogHeader>
        @if (_detailsTarget is not null)
        {
            <dl class="grid grid-cols-[150px_1fr] gap-x-4 gap-y-3 text-sm">
                <dt class="text-muted-foreground">Descripción</dt>
                <dd>@(string.IsNullOrEmpty(_detailsTarget.Description) ? "—" : _detailsTarget.Description)</dd>
                <dt class="text-muted-foreground">Departamento</dt>
                <dd>@(_detailsTarget.DepartmentName ?? "Sin departamento")</dd>
                <dt class="text-muted-foreground">Publicadores</dt>
                <dd><EntityChips Items="@_detailsTarget.PublisherNames" Max="int.MaxValue"/></dd>
            </dl>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _detailsOpen = false)">
                <ChildContent>Cerrar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<ResponsibilityDto> _responsibilities = [];
    private SelectOption<Guid?>[] _departmentOptions = [];
    private SelectOption<Guid>[] _publisherOptions = [];

    private bool _formOpen;
    private bool _isNew;
    private ResponsibilityFormModel _editing = new();
    private IEnumerable<Guid> _selectedPublishers = [];
    private string? _formError;

    private bool _deleteOpen;
    private ResponsibilityDto? _deleteTarget;

    private bool _detailsOpen;
    private ResponsibilityDto? _detailsTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _responsibilities = (await GetResponsibilities.HandleAsync()).ToList();

        var options = await GetResponsibilityOptions.HandleAsync();
        _departmentOptions = options.Departments
            .Select(d => new SelectOption<Guid?>(d.Id, d.Name))
            .OrderBy(o => o.Text)
            .ToArray();
        _publisherOptions = options.Publishers
            .Select(p => new SelectOption<Guid>(p.Id, p.Name))
            .OrderBy(o => o.Text, NameComparer)
            .ToArray();
    }

    private void OpenCreate()
    {
        _isNew = true;
        _editing = new ResponsibilityFormModel { Name = string.Empty };
        _selectedPublishers = [];
        _formError = null;
        _formOpen = true;
    }

    private async Task OpenEdit(ResponsibilityDto responsibility)
    {
        _isNew = false;
        var dto = await GetResponsibilityById.HandleAsync(responsibility.Id);
        _editing = MapToForm(dto);
        _selectedPublishers = SortByPublisherOrder(dto?.PublisherIds ?? []);
        _formError = null;
        _formOpen = true;
    }

    private static ResponsibilityFormModel MapToForm(ResponsibilityDto? dto) => dto is null
        ? new ResponsibilityFormModel()
        : new ResponsibilityFormModel
        {
            Id = dto.Id,
            Name = dto.Name,
            Description = dto.Description,
            DepartmentId = dto.DepartmentId
        };

    private async Task SaveAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _formError = "El nombre es obligatorio.";
            return;
        }

        var publisherIds = _selectedPublishers.ToArray();

        try
        {
            if (_isNew)
            {
                await CreateResponsibility.HandleAsync(new CreateResponsibilityCommand(
                    _editing.Name,
                    _editing.Description,
                    _editing.DepartmentId,
                    publisherIds));
            }
            else
            {
                await UpdateResponsibility.HandleAsync(new UpdateResponsibilityCommand(
                    _editing.Id,
                    _editing.Name,
                    _editing.Description,
                    _editing.DepartmentId,
                    publisherIds));
            }

            _formOpen = false;
            await LoadAsync();
        }
        catch (DuplicateEntityException ex)
        {
            _formError = ex.Message;
        }
        catch
        {
            _formError = "No se pudo guardar la responsabilidad.";
        }
    }

    private void OpenDelete(ResponsibilityDto responsibility)
    {
        _deleteTarget = responsibility;
        _deleteOpen = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null)
        {
            return;
        }

        try
        {
            await DeleteResponsibility.HandleAsync(_deleteTarget.Id);
        }
        catch
        {
            // Ignored: reload shows the current state.
        }

        _deleteOpen = false;
        await LoadAsync();
    }

    private void OpenDetails(ResponsibilityDto responsibility)
    {
        _detailsTarget = responsibility;
        _detailsOpen = true;
    }

    private void OnPublishersChanged(IEnumerable<Guid>? values) =>
        _selectedPublishers = SortByPublisherOrder(values);

    private IEnumerable<Guid> SortByPublisherOrder(IEnumerable<Guid>? ids)
    {
        if (ids is null)
        {
            return [];
        }

        var rank = _publisherOptions.Select((o, i) => (o.Value, Index: i)).ToDictionary(x => x.Value, x => x.Index);
        return ids.OrderBy(id => rank.TryGetValue(id, out var i) ? i : int.MaxValue).ToList();
    }

    private static readonly StringComparer NameComparer =
        StringComparer.Create(CultureInfo.GetCultureInfo("es-ES"), true);
}

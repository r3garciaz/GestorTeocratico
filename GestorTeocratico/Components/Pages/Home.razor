@page "/dashboard"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using System.Security.Claims
@using GestorTeocratico.Features.Publishers
@using GestorTeocratico.Features.Departments
@using GestorTeocratico.Features.Responsibilities
@using GestorTeocratico.Features.MeetingSchedules
@using GestorTeocratico.Features.Congregations
@using GestorTeocratico.Entities
@using GestorTeocratico.Shared.Enums
@using BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject GetPublishersHandler GetPublishers
@inject GetDepartmentsHandler GetDepartments
@inject GetResponsibilitiesHandler GetResponsibilities
@inject GetAllMeetingSchedulesHandler GetAllSchedules
@inject GetCongregationsHandler GetCongregations

<PageTitle>Inicio - Gestor Teocrático</PageTitle>

<div class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Hola, @_userName</h1>
            <p class="text-sm text-muted-foreground">
                Resumen de tu congregación · @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", Spanish)
            </p>
        </div>
        <BbButton Variant="ButtonVariant.Outline" OnClick="@RefreshDashboard">
            <Icon><LucideIcon Name="refresh-cw"/></Icon>
            <ChildContent>Actualizar</ChildContent>
        </BbButton>
    </div>

    @if (_loading)
    {
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            @for (var i = 0; i < 4; i++)
            {
                <div class="h-28 animate-pulse rounded-lg border bg-muted/40"></div>
            }
        </div>
    }
    else
    {
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var kpi in Kpis)
            {
                <a href="@kpi.Href" class="block transition-transform hover:-translate-y-0.5">
                    <BbCard>
                        <BbCardContent Class="pt-6">
                            <div class="flex items-center justify-between">
                                <p class="text-sm font-medium text-muted-foreground">@kpi.Label</p>
                                <div class="flex size-8 items-center justify-center rounded-full bg-primary/10 text-primary">
                                    <LucideIcon Name="@kpi.Icon" Class="size-4"/>
                                </div>
                            </div>
                            <div class="mt-2">
                                <h2 class="text-3xl font-bold tracking-tight">@kpi.Value</h2>
                                <p class="mt-1 text-xs text-muted-foreground">@kpi.Hint</p>
                            </div>
                        </BbCardContent>
                    </BbCard>
                </a>
            }
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Próximas reuniones</BbCardTitle>
                    <BbCardDescription>Las siguientes programaciones registradas.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    @if (_upcoming.Count == 0)
                    {
                        <p class="text-sm text-muted-foreground">No hay reuniones programadas próximamente.</p>
                    }
                    else
                    {
                        <ul class="divide-y">
                            @foreach (var meeting in _upcoming)
                            {
                                <li class="flex items-center justify-between gap-3 py-3">
                                    <div class="flex items-center gap-3">
                                        <div class="flex size-9 items-center justify-center rounded-md bg-muted text-muted-foreground">
                                            <LucideIcon Name="calendar-days" Class="size-4"/>
                                        </div>
                                        <div>
                                            <p class="text-sm font-medium">@MeetingLabel(meeting.MeetingType)</p>
                                            <p class="text-xs text-muted-foreground">
                                                @meeting.Date.ToString("dd MMM yyyy", Spanish)
                                            </p>
                                        </div>
                                    </div>
                                    <BbBadge Variant="BadgeVariant.Secondary">Semana @meeting.WeekOfYear</BbBadge>
                                </li>
                            }
                        </ul>
                    }
                </BbCardContent>
            </BbCard>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Accesos rápidos</BbCardTitle>
                    <BbCardDescription>Ve directamente a cada sección.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent Class="grid gap-2 sm:grid-cols-2">
                    @foreach (var action in QuickActions)
                    {
                        <BbButton Href="@action.Href" Variant="ButtonVariant.Outline" Class="justify-start">
                            <Icon><LucideIcon Name="@action.Icon"/></Icon>
                            <ChildContent>@action.Label</ChildContent>
                        </BbButton>
                    }
                </BbCardContent>
            </BbCard>
        </div>
    }
</div>

@code {
    private static readonly CultureInfo Spanish = new("es-ES");

    private string _userName = "";
    private bool _loading = true;
    private int _publishers;
    private int _elders;
    private int _servants;
    private int _departments;
    private int _responsibilities;
    private int _congregations;
    private List<MeetingScheduleDto> _upcoming = [];
    private readonly CancellationTokenSource _cts = new();

    private IEnumerable<Kpi> Kpis =>
    [
        new("Publicadores", _publishers.ToString(), $"{_elders} ancianos · {_servants} siervos ministeriales", "users", "/publishers"),
        new("Departamentos", _departments.ToString(), "Departamentos registrados", "building-2", "/departments"),
        new("Responsabilidades", _responsibilities.ToString(), "Responsabilidades definidas", "clipboard-list", "/responsibilities"),
        new("Congregaciones", _congregations.ToString(), "Congregaciones registradas", "church", "/congregations")
    ];

    private static readonly QuickAction[] QuickActions =
    [
        new("Publicadores", "/publishers", "users"),
        new("Departamentos", "/departments", "building-2"),
        new("Responsabilidades", "/responsibilities", "clipboard-list"),
        new("Programación", "/meeting-schedules", "calendar-days")
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userName = authState.User.Identity?.Name ?? "";
        await LoadAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task RefreshDashboard() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        try
        {
            var publishers = await GetPublishers.HandleAsync(_cts.Token);
            _publishers = publishers.Count;
            _elders = publishers.Count(p => p.Privilege == Privilege.Elder);
            _servants = publishers.Count(p => p.Privilege == Privilege.MinisterialServant);

            _departments = (await GetDepartments.HandleAsync(_cts.Token)).Count;
            _responsibilities = (await GetResponsibilities.HandleAsync(_cts.Token)).Count;
            _congregations = (await GetCongregations.HandleAsync(_cts.Token)).Count;

            var schedules = await GetAllSchedules.HandleAsync(_cts.Token);
            var today = DateOnly.FromDateTime(DateTime.Today);
            _upcoming = schedules
                .Where(s => s.Date >= today)
                .OrderBy(s => s.Date)
                .Take(5)
                .ToList();
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }

        _loading = false;
    }

    private static string MeetingLabel(MeetingType type) => type switch
    {
        MeetingType.Midweek => "Reunión entre semana",
        MeetingType.Weekend => "Reunión de fin de semana",
        _ => type.ToString()
    };

    private sealed record Kpi(string Label, string Value, string Hint, string Icon, string Href);

    private sealed record QuickAction(string Label, string Href, string Icon);
}

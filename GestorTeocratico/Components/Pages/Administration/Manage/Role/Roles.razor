@page "/administration/roles"
@attribute [Authorize(Roles = "Admin, Manager")]
@using Microsoft.AspNetCore.Identity
@using GestorTeocratico.Features.Roles
@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Icons.Lucide.Components
@using ButtonSize = BlazorBlueprint.Components.ButtonSize

@inject IRoleService RoleService
@inject ToastService Toasts

<PageTitle>Roles</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Roles</h1>
        <p class="text-sm text-muted-foreground">Roles disponibles para asignar a los usuarios.</p>
    </div>

    <BbDataTable TData="IdentityRole" Data="@_roles" InitialPageSize="10" AriaLabel="Roles">
        <ToolbarActions>
            <BbButton OnClick="OpenCreate">
                <Icon><LucideIcon Name="plus"/></Icon>
                <ChildContent>Agregar rol</ChildContent>
            </BbButton>
        </ToolbarActions>
        <Columns>
            <BbDataTableColumn TData="IdentityRole" TValue="string" Property="@(r => r.Name)"
                               Header="Nombre" Sortable="true" Filterable="true"/>
            <BbDataTableColumn TData="IdentityRole" TValue="string" Header="Acciones" Width="110px">
                <CellTemplate Context="r">
                    <div class="flex items-center gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Editar"
                                  OnClick="@(() => OpenEdit(r))">
                            <LucideIcon Name="pencil" Class="size-4"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Eliminar"
                                  OnClick="@(() => OpenDelete(r))">
                            <LucideIcon Name="trash-2" Class="size-4 text-destructive"/>
                        </BbButton>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</div>

<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@(_isNew ? "Agregar rol" : "Editar rol")</BbDialogTitle>
            <BbDialogDescription>@(_isNew ? "Crea un nuevo rol." : "Cambia el nombre del rol.")</BbDialogDescription>
        </BbDialogHeader>

        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="rounded-md border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive">
                @_formError
            </div>
        }

        <div class="space-y-2">
            <BbLabel For="RoleName">Nombre *</BbLabel>
            <BbInput Id="RoleName" @bind-Value="_roleName" Placeholder="Nombre del rol"/>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _formOpen = false)">
                <ChildContent>Cancelar</ChildContent>
            </BbButton>
            <BbButton OnClick="SaveAsync">
                <ChildContent>Guardar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="_deleteOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Eliminar rol</BbDialogTitle>
            <BbDialogDescription>
                ¿Seguro que deseas eliminar el rol <strong>@_deleteTarget?.Name</strong>?
            </BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _deleteOpen = false)">
                <ChildContent>Cancelar</ChildContent>
            </BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmDeleteAsync">
                <ChildContent>Eliminar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<IdentityRole> _roles = [];

    private bool _formOpen;
    private bool _isNew;
    private string _roleName = "";
    private IdentityRole? _editing;
    private string? _formError;

    private bool _deleteOpen;
    private IdentityRole? _deleteTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _roles = (await RoleService.GetAllAsync()).ToList();

    private void OpenCreate()
    {
        _isNew = true;
        _editing = null;
        _roleName = "";
        _formError = null;
        _formOpen = true;
    }

    private void OpenEdit(IdentityRole role)
    {
        _isNew = false;
        _editing = role;
        _roleName = role.Name ?? "";
        _formError = null;
        _formOpen = true;
    }

    private async Task SaveAsync()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_roleName))
        {
            _formError = "El nombre es obligatorio.";
            return;
        }

        try
        {
            if (_isNew)
            {
                await RoleService.CreateAsync(_roleName.Trim());
                Toasts.Success("Rol creado.", "Guardado");
            }
            else if (_editing is not null)
            {
                await RoleService.UpdateAsync(_editing.Id, _roleName.Trim());
                Toasts.Success("Rol actualizado.", "Guardado");
            }

            _formOpen = false;
            await LoadAsync();
        }
        catch
        {
            _formError = "No se pudo guardar el rol.";
        }
    }

    private void OpenDelete(IdentityRole role)
    {
        _deleteTarget = role;
        _deleteOpen = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null)
        {
            return;
        }

        try
        {
            await RoleService.DeleteAsync(_deleteTarget.Id);
        }
        catch
        {
            // Ignored: reload shows the current state.
        }

        _deleteOpen = false;
        await LoadAsync();
    }
}

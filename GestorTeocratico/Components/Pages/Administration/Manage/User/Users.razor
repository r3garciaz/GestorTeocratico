@page "/administration/users"
@attribute [Authorize(Roles = "Admin, Manager")]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using GestorTeocratico.Data
@using GestorTeocratico.Shared
@using GestorTeocratico.Features.Roles
@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Icons.Lucide.Components
@using ButtonSize = BlazorBlueprint.Components.ButtonSize

@inject UserManager<ApplicationUser> UserManager
@inject IRoleService RoleService
@inject ToastService Toasts

<PageTitle>Administrar Usuarios</PageTitle>

<div class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Usuarios</h1>
            <p class="text-sm text-muted-foreground">Administra los usuarios y sus roles.</p>
        </div>
        <BbButton Variant="ButtonVariant.Outline" OnClick="LoadAsync">
            <Icon><LucideIcon Name="refresh-cw"/></Icon>
            <ChildContent>Actualizar</ChildContent>
        </BbButton>
    </div>

    <div class="grid gap-3 sm:grid-cols-3">
        <BbInput Placeholder="Buscar por correo..." @bind-Value="_searchEmail" UpdateTiming="UpdateTiming.Immediate"/>
        <BbInput Placeholder="Buscar por ID público..." @bind-Value="_searchPublicId" UpdateTiming="UpdateTiming.Immediate"/>
        <BbSelect TValue="string?" Options="_roleFilterOptions" @bind-Value="_roleFilter" Placeholder="Filtrar por rol"/>
    </div>

    <BbDataTable TData="ApplicationUser" Data="@(FilteredUsers)" InitialPageSize="15" AriaLabel="Usuarios">
        <Columns>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Property="@(u => u.PublicId)"
                               Header="ID público" Sortable="true" Width="130px">
                <CellTemplate Context="u">
                    <BbBadge Variant="BadgeVariant.Secondary">@u.PublicId</BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Property="@(u => u.Email)"
                               Header="Correo" Sortable="true" Filterable="true">
                <CellTemplate Context="u">
                    <span class="inline-flex items-center gap-2">
                        <LucideIcon Name="@(u.EmailConfirmed ? "badge-check" : "mail")"
                                    Class="@(u.EmailConfirmed ? "size-4 text-emerald-500" : "size-4 text-muted-foreground")"/>
                        @u.Email
                    </span>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Property="@(u => u.UserName)"
                               Header="Usuario" Sortable="true" Filterable="true"/>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Header="Roles">
                <CellTemplate Context="u">
                    <div class="flex flex-wrap gap-1">
                        @foreach (var role in RolesOf(u.Id))
                        {
                            <BbBadge Variant="@RoleVariant(role)">@RoleDisplay(role)</BbBadge>
                        }
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Header="Acciones" Width="150px">
                <CellTemplate Context="u">
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              OnClick="@(() => OpenManageRoles(u))">
                        <Icon><LucideIcon Name="shield"/></Icon>
                        <ChildContent>Roles</ChildContent>
                    </BbButton>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</div>

<BbDialog @bind-Open="_rolesOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Roles de @_rolesUser?.Email</BbDialogTitle>
            <BbDialogDescription>Asigna o quita roles a este usuario.</BbDialogDescription>
        </BbDialogHeader>

        <div class="space-y-2">
            <BbLabel>Roles</BbLabel>
            <BbMultiSelect TValue="string" Options="_roleOptions"
                           @bind-Values="_selectedRoles" Placeholder="Selecciona roles"/>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _rolesOpen = false)">
                <ChildContent>Cancelar</ChildContent>
            </BbButton>
            <BbButton OnClick="SaveRolesAsync">
                <ChildContent>Guardar cambios</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<ApplicationUser> _users = [];
    private readonly Dictionary<string, List<string>> _userRoles = new();

    private string? _searchEmail;
    private string? _searchPublicId;
    private string? _roleFilter;

    private SelectOption<string?>[] _roleFilterOptions = [];
    private SelectOption<string>[] _roleOptions = [];

    private bool _rolesOpen;
    private ApplicationUser? _rolesUser;
    private IEnumerable<string> _selectedRoles = [];

    private IEnumerable<ApplicationUser> FilteredUsers => _users.Where(u =>
        (string.IsNullOrWhiteSpace(_searchEmail)
            || (u.Email?.Contains(_searchEmail, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (string.IsNullOrWhiteSpace(_searchPublicId)
            || (u.PublicId?.Contains(_searchPublicId, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (string.IsNullOrWhiteSpace(_roleFilter)
            || RolesOf(u.Id).Contains(_roleFilter)));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _users = await UserManager.Users.OrderBy(u => u.Email).ToListAsync();

        _userRoles.Clear();
        foreach (var user in _users)
        {
            _userRoles[user.Id] = (await UserManager.GetRolesAsync(user)).ToList();
        }

        var roles = (await RoleService.GetAllAsync()).ToList();
        _roleFilterOptions =
        [
            new((string?)null, "Todos los roles"),
            .. roles.Select(r => new SelectOption<string?>(r.Name, RoleDisplay(r.Name ?? "")))
        ];
        _roleOptions = roles
            .Select(r => new SelectOption<string>(r.Name ?? "", RoleDisplay(r.Name ?? "")))
            .ToArray();
    }

    private List<string> RolesOf(string userId) =>
        _userRoles.TryGetValue(userId, out var roles) ? roles : [];

    private void OpenManageRoles(ApplicationUser user)
    {
        _rolesUser = user;
        _selectedRoles = RolesOf(user.Id).ToList();
        _rolesOpen = true;
    }

    private async Task SaveRolesAsync()
    {
        if (_rolesUser is null)
        {
            return;
        }

        var current = RolesOf(_rolesUser.Id);
        var selected = _selectedRoles.ToList();
        var toAdd = selected.Except(current).ToList();
        var toRemove = current.Except(selected).ToList();

        try
        {
            if (toRemove.Count > 0)
            {
                await UserManager.RemoveFromRolesAsync(_rolesUser, toRemove);
            }
            if (toAdd.Count > 0)
            {
                await UserManager.AddToRolesAsync(_rolesUser, toAdd);
            }

            Toasts.Success("Roles actualizados.", "Guardado");
            _rolesOpen = false;
            await LoadAsync();
        }
        catch
        {
            Toasts.Error("No se pudieron actualizar los roles.", "Error");
        }
    }

    private static string RoleDisplay(string role) => role switch
    {
        Shared.Roles.Admin => "Administrador",
        Shared.Roles.Manager => "Manager",
        Shared.Roles.User => "Usuario",
        _ => role
    };

    private static BadgeVariant RoleVariant(string role) => role switch
    {
        Shared.Roles.Admin => BadgeVariant.Destructive,
        Shared.Roles.Manager => BadgeVariant.Default,
        Shared.Roles.User => BadgeVariant.Secondary,
        _ => BadgeVariant.Outline
    };
}

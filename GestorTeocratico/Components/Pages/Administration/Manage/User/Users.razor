@page "/administration/users"
@attribute [Authorize(Roles = "Admin, Manager")]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using GestorTeocratico.Data
@using GestorTeocratico.Shared
@using GestorTeocratico.Features.Roles
@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Icons.Lucide.Components
@using ButtonSize = BlazorBlueprint.Components.ButtonSize

@inject UserManager<ApplicationUser> UserManager
@inject IRoleService RoleService
@inject ToastService Toasts

<PageTitle>Administrar Usuarios</PageTitle>

<div class="space-y-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-semibold tracking-tight">Usuarios</h1>
            <p class="text-sm text-muted-foreground">Administra los usuarios, sus roles y su estado.</p>
        </div>
        <BbButton Variant="ButtonVariant.Outline" OnClick="LoadAsync">
            <Icon><LucideIcon Name="refresh-cw"/></Icon>
            <ChildContent>Actualizar</ChildContent>
        </BbButton>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <BbCard>
            <BbCardContent Class="pt-6">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-muted-foreground">Total usuarios</p>
                    <LucideIcon Name="users" Class="size-4 text-muted-foreground"/>
                </div>
                <p class="mt-2 text-3xl font-bold tracking-tight">@_totalUsers</p>
            </BbCardContent>
        </BbCard>
        <BbCard>
            <BbCardContent Class="pt-6">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-muted-foreground">Administradores</p>
                    <LucideIcon Name="shield" Class="size-4 text-muted-foreground"/>
                </div>
                <p class="mt-2 text-3xl font-bold tracking-tight">@_adminCount</p>
            </BbCardContent>
        </BbCard>
        <BbCard>
            <BbCardContent Class="pt-6">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-muted-foreground">Managers</p>
                    <LucideIcon Name="user-cog" Class="size-4 text-muted-foreground"/>
                </div>
                <p class="mt-2 text-3xl font-bold tracking-tight">@_managerCount</p>
            </BbCardContent>
        </BbCard>
        <BbCard>
            <BbCardContent Class="pt-6">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-muted-foreground">Usuarios</p>
                    <LucideIcon Name="user" Class="size-4 text-muted-foreground"/>
                </div>
                <p class="mt-2 text-3xl font-bold tracking-tight">@_userCount</p>
            </BbCardContent>
        </BbCard>
    </div>

    <div class="grid gap-3 sm:grid-cols-3">
        <BbInput Placeholder="Buscar por correo..." @bind-Value="_searchEmail" UpdateTiming="UpdateTiming.Immediate"/>
        <BbInput Placeholder="Buscar por ID público..." @bind-Value="_searchPublicId" UpdateTiming="UpdateTiming.Immediate"/>
        <BbSelect TValue="string?" Options="_roleFilterOptions" @bind-Value="_roleFilter" Placeholder="Filtrar por rol"/>
    </div>

    <BbDataTable TData="ApplicationUser" Data="@(FilteredUsers)" InitialPageSize="15" AriaLabel="Usuarios">
        <Columns>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Property="@(u => u.PublicId)"
                               Header="ID público" Sortable="true" Width="130px">
                <CellTemplate Context="u">
                    <BbBadge Variant="BadgeVariant.Secondary">@u.PublicId</BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Property="@(u => u.Email)"
                               Header="Correo" Sortable="true" Filterable="true">
                <CellTemplate Context="u">
                    <span class="inline-flex items-center gap-2">
                        <LucideIcon Name="@(u.EmailConfirmed ? "badge-check" : "mail")"
                                    Class="@(u.EmailConfirmed ? "size-4 text-emerald-500" : "size-4 text-muted-foreground")"/>
                        @u.Email
                    </span>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Property="@(u => u.UserName)"
                               Header="Usuario" Sortable="true" Filterable="true"/>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Header="Roles">
                <CellTemplate Context="u">
                    <div class="flex flex-wrap gap-1">
                        @foreach (var role in RolesOf(u.Id))
                        {
                            <BbBadge Variant="@RoleVariant(role)">@RoleDisplay(role)</BbBadge>
                        }
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ApplicationUser" TValue="System.DateTimeOffset?" Property="@(u => u.LockoutEnd)"
                               Header="Estado" Sortable="true" Width="120px">
                <CellTemplate Context="u">
                    <BbBadge Variant="@(IsLocked(u) ? BadgeVariant.Destructive : BadgeVariant.Secondary)">
                        @(IsLocked(u) ? "Bloqueado" : "Activo")
                    </BbBadge>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="ApplicationUser" TValue="string" Header="Acciones" Width="150px">
                <CellTemplate Context="u">
                    <div class="flex items-center gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Administrar roles"
                                  OnClick="@(() => OpenManageRoles(u))">
                            <LucideIcon Name="shield" Class="size-4"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                  AriaLabel="@(IsLocked(u) ? "Desbloquear usuario" : "Bloquear usuario")"
                                  OnClick="@(() => ToggleLockoutAsync(u))">
                            <LucideIcon Name="@(IsLocked(u) ? "lock-open" : "lock")"
                                        Class="@(IsLocked(u) ? "size-4 text-emerald-500" : "size-4 text-amber-500")"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Ver detalles"
                                  OnClick="@(() => OpenDetails(u))">
                            <LucideIcon Name="info" Class="size-4"/>
                        </BbButton>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</div>

@* ===== Gestionar roles ===== *@
<BbDialog @bind-Open="_rolesOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Roles de @_rolesUser?.Email</BbDialogTitle>
            <BbDialogDescription>Asigna o quita roles a este usuario.</BbDialogDescription>
        </BbDialogHeader>

        <div class="space-y-2">
            <BbLabel>Roles</BbLabel>
            <BbMultiSelect TValue="string" Options="_roleOptions"
                           @bind-Values="_selectedRoles" Placeholder="Selecciona roles"/>
        </div>

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _rolesOpen = false)">
                <ChildContent>Cancelar</ChildContent>
            </BbButton>
            <BbButton OnClick="SaveRolesAsync">
                <ChildContent>Guardar cambios</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@* ===== Ver detalles ===== *@
<BbDialog @bind-Open="_detailsOpen">
    <BbDialogContent Class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>@(_detailsUser?.UserName ?? "Usuario")</BbDialogTitle>
            <BbDialogDescription>@_detailsUser?.Email</BbDialogDescription>
        </BbDialogHeader>

        @if (_detailsUser is not null)
        {
            <div class="flex flex-wrap items-center gap-2">
                <BbBadge Variant="BadgeVariant.Secondary">ID: @_detailsUser.PublicId</BbBadge>
                <BbBadge Variant="@(IsLocked(_detailsUser) ? BadgeVariant.Destructive : BadgeVariant.Secondary)">
                    @(IsLocked(_detailsUser) ? "Bloqueado" : "Activo")
                </BbBadge>
                @foreach (var role in RolesOf(_detailsUser.Id))
                {
                    <BbBadge Variant="@RoleVariant(role)">@RoleDisplay(role)</BbBadge>
                }
            </div>

            <div class="space-y-4 text-sm">
                <section class="space-y-2">
                    <h4 class="font-medium">Cuenta</h4>
                    <dl class="grid grid-cols-[190px_1fr] gap-x-4 gap-y-2">
                        <dt class="text-muted-foreground">Correo confirmado</dt>
                        <dd>@( _detailsUser.EmailConfirmed ? "Sí" : "No")</dd>
                        <dt class="text-muted-foreground">Teléfono</dt>
                        <dd>@(string.IsNullOrEmpty(_detailsUser.PhoneNumber) ? "No especificado" : _detailsUser.PhoneNumber)</dd>
                        <dt class="text-muted-foreground">Teléfono confirmado</dt>
                        <dd>@( _detailsUser.PhoneNumberConfirmed ? "Sí" : "No")</dd>
                        <dt class="text-muted-foreground">Autenticación 2FA</dt>
                        <dd>@( _detailsUser.TwoFactorEnabled ? "Habilitada" : "Deshabilitada")</dd>
                    </dl>
                </section>

                <section class="space-y-2">
                    <h4 class="font-medium">Seguridad</h4>
                    <dl class="grid grid-cols-[190px_1fr] gap-x-4 gap-y-2">
                        <dt class="text-muted-foreground">Intentos fallidos</dt>
                        <dd>@_detailsUser.AccessFailedCount</dd>
                        <dt class="text-muted-foreground">Bloqueo habilitado</dt>
                        <dd>@( _detailsUser.LockoutEnabled ? "Sí" : "No")</dd>
                        @if (_detailsUser.LockoutEnd.HasValue)
                        {
                            <dt class="text-muted-foreground">Bloqueado hasta</dt>
                            <dd>@_detailsUser.LockoutEnd.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                        }
                    </dl>
                </section>

                <section class="space-y-2">
                    <h4 class="font-medium">Técnica</h4>
                    <dl class="grid grid-cols-[190px_1fr] gap-x-4 gap-y-2">
                        <dt class="text-muted-foreground">ID del usuario</dt>
                        <dd class="break-all">@_detailsUser.Id</dd>
                        <dt class="text-muted-foreground">Sello de seguridad</dt>
                        <dd>@(string.IsNullOrEmpty(_detailsUser.SecurityStamp) ? "No especificado" : _detailsUser.SecurityStamp[..Math.Min(8, _detailsUser.SecurityStamp.Length)] + "…")</dd>
                    </dl>
                </section>
            </div>
        }

        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _detailsOpen = false)">
                <ChildContent>Cerrar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<ApplicationUser> _users = [];
    private readonly Dictionary<string, List<string>> _userRoles = new();

    private int _totalUsers;
    private int _adminCount;
    private int _managerCount;
    private int _userCount;

    private string? _searchEmail;
    private string? _searchPublicId;
    private string? _roleFilter;

    private SelectOption<string?>[] _roleFilterOptions = [];
    private SelectOption<string>[] _roleOptions = [];

    private bool _rolesOpen;
    private ApplicationUser? _rolesUser;
    private IEnumerable<string> _selectedRoles = [];

    private bool _detailsOpen;
    private ApplicationUser? _detailsUser;

    private IEnumerable<ApplicationUser> FilteredUsers => _users.Where(u =>
        (string.IsNullOrWhiteSpace(_searchEmail)
            || (u.Email?.Contains(_searchEmail, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (string.IsNullOrWhiteSpace(_searchPublicId)
            || (u.PublicId?.Contains(_searchPublicId, StringComparison.OrdinalIgnoreCase) ?? false)) &&
        (string.IsNullOrWhiteSpace(_roleFilter)
            || RolesOf(u.Id).Contains(_roleFilter)));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _users = await UserManager.Users.OrderBy(u => u.Email).ToListAsync();

        _userRoles.Clear();
        foreach (var user in _users)
        {
            _userRoles[user.Id] = (await UserManager.GetRolesAsync(user)).ToList();
        }

        _totalUsers = _users.Count;
        _adminCount = _userRoles.Values.Count(r => r.Contains(Shared.Roles.Admin));
        _managerCount = _userRoles.Values.Count(r => r.Contains(Shared.Roles.Manager));
        _userCount = _userRoles.Values.Count(r => r.Contains(Shared.Roles.User));

        var roles = (await RoleService.GetAllAsync()).ToList();
        _roleFilterOptions =
        [
            new((string?)null, "Todos los roles"),
            .. roles.Select(r => new SelectOption<string?>(r.Name, RoleDisplay(r.Name ?? "")))
        ];
        _roleOptions = roles
            .Select(r => new SelectOption<string>(r.Name ?? "", RoleDisplay(r.Name ?? "")))
            .ToArray();
    }

    private static bool IsLocked(ApplicationUser user) =>
        user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow;

    private List<string> RolesOf(string userId) =>
        _userRoles.TryGetValue(userId, out var roles) ? roles : [];

    private void OpenManageRoles(ApplicationUser user)
    {
        _rolesUser = user;
        _selectedRoles = RolesOf(user.Id).ToList();
        _rolesOpen = true;
    }

    private async Task SaveRolesAsync()
    {
        if (_rolesUser is null)
        {
            return;
        }

        var current = RolesOf(_rolesUser.Id);
        var selected = _selectedRoles.ToList();
        var toAdd = selected.Except(current).ToList();
        var toRemove = current.Except(selected).ToList();

        try
        {
            if (toRemove.Count > 0)
            {
                await UserManager.RemoveFromRolesAsync(_rolesUser, toRemove);
            }
            if (toAdd.Count > 0)
            {
                await UserManager.AddToRolesAsync(_rolesUser, toAdd);
            }

            Toasts.Success("Roles actualizados.", "Guardado");
            _rolesOpen = false;
            await LoadAsync();
        }
        catch
        {
            Toasts.Error("No se pudieron actualizar los roles.", "Error");
        }
    }

    private async Task ToggleLockoutAsync(ApplicationUser user)
    {
        try
        {
            if (IsLocked(user))
            {
                await UserManager.SetLockoutEndDateAsync(user, null);
                Toasts.Success($"El usuario {user.Email} ha sido desbloqueado.", "Usuario desbloqueado");
            }
            else
            {
                await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.UtcNow.AddDays(30));
                Toasts.Warning($"El usuario {user.Email} ha sido bloqueado.", "Usuario bloqueado");
            }

            await LoadAsync();
        }
        catch
        {
            Toasts.Error("No se pudo cambiar el estado del usuario.", "Error");
        }
    }

    private void OpenDetails(ApplicationUser user)
    {
        _detailsUser = user;
        _detailsOpen = true;
    }

    private static string RoleDisplay(string role) => role switch
    {
        Shared.Roles.Admin => "Administrador",
        Shared.Roles.Manager => "Manager",
        Shared.Roles.User => "Usuario",
        _ => role
    };

    private static BadgeVariant RoleVariant(string role) => role switch
    {
        Shared.Roles.Admin => BadgeVariant.Destructive,
        Shared.Roles.Manager => BadgeVariant.Default,
        Shared.Roles.User => BadgeVariant.Secondary,
        _ => BadgeVariant.Outline
    };
}

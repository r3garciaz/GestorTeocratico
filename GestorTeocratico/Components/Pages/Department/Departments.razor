@page "/departments"
@attribute [Authorize(Roles = "Admin, Manager")]
@using GestorTeocratico.Entities
@using GestorTeocratico.Features.Departments
@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Icons.Lucide.Components
@using ButtonSize = BlazorBlueprint.Components.ButtonSize

@inject IDepartmentService DepartmentService

<PageTitle>Departamentos</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Departamentos</h1>
        <p class="text-sm text-muted-foreground">Departamentos, responsables y sus responsabilidades.</p>
    </div>

    <BbDataTable TData="Department" Data="@_departments" InitialPageSize="10" AriaLabel="Departamentos">
        <ToolbarActions>
            <BbButton OnClick="OpenCreate">
                <Icon><LucideIcon Name="plus"/></Icon>
                <ChildContent>Agregar departamento</ChildContent>
            </BbButton>
        </ToolbarActions>
        <Columns>
            <BbDataTableColumn TData="Department" TValue="string" Property="@(d => d.Name)"
                               Header="Nombre" Sortable="true" Filterable="true"/>
            <BbDataTableColumn TData="Department" TValue="string" Header="Publicador responsable" Width="240px">
                <CellTemplate Context="d">
                    @if (d.ResponsiblePublisher is not null)
                    {
                        <span class="inline-flex items-center gap-2">
                            <BbAvatar Size="AvatarSize.Small">
                                <BbAvatarFallback>@Initials(PublisherName(d.ResponsiblePublisher))</BbAvatarFallback>
                            </BbAvatar>
                            <span class="truncate">@PublisherName(d.ResponsiblePublisher)</span>
                        </span>
                    }
                    else
                    {
                        <span class="text-muted-foreground">Sin asignar</span>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="Department" TValue="string" Header="Responsabilidades" Width="240px">
                <CellTemplate Context="d">
                    <EntityChips Items="@(d.Responsibilities?.Select(r => r.Name).ToList() ?? [])" Max="int.MaxValue"/>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="Department" TValue="string" Header="Acciones" Width="150px">
                <CellTemplate Context="d">
                    <div class="flex items-center gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Ver"
                                  OnClick="@(() => OpenDetails(d))">
                            <LucideIcon Name="eye" Class="size-4"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Editar"
                                  OnClick="@(() => OpenEdit(d))">
                            <LucideIcon Name="pencil" Class="size-4"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Eliminar"
                                  OnClick="@(() => OpenDelete(d))">
                            <LucideIcon Name="trash-2" Class="size-4 text-destructive"/>
                        </BbButton>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</div>

@* ===== Formulario crear/editar ===== *@
<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>@(_isNew ? "Agregar departamento" : "Editar departamento")</BbDialogTitle>
            <BbDialogDescription>Define el departamento y sus responsabilidades.</BbDialogDescription>
        </BbDialogHeader>

        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="rounded-md border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive">
                @_formError
            </div>
        }

        <EditForm Model="_editing" OnValidSubmit="SaveAsync" class="space-y-4">
            <div class="space-y-2">
                <BbLabel For="Name">Nombre *</BbLabel>
                <BbInput Id="Name" @bind-Value="_editing.Name" Placeholder="Nombre del departamento"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Publicador responsable</BbLabel>
                <BbCombobox TValue="Guid?" Options="_publisherOptions" SearchPlaceholder="Buscar publicador..."
                            @bind-Value="_editing.ResponsiblePublisherId" Placeholder="Sin asignar"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Responsabilidades</BbLabel>
                <BbMultiSelect TValue="Guid" Options="_responsibilityOptions" MaxDisplayTags="5" SingleLine="true"
                               @bind-Values="_selectedResponsibilities" Placeholder="Selecciona responsabilidades"/>
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _formOpen = false)">
                    <ChildContent>Cancelar</ChildContent>
                </BbButton>
                <BbButton Type="BlazorBlueprint.Components.ButtonType.Submit">
                    <ChildContent>Guardar</ChildContent>
                </BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@* ===== Confirmar eliminación ===== *@
<BbDialog @bind-Open="_deleteOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Eliminar departamento</BbDialogTitle>
            <BbDialogDescription>
                ¿Seguro que deseas eliminar <strong>@_deleteTarget?.Name</strong>? Esta acción no se puede deshacer.
            </BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _deleteOpen = false)">
                <ChildContent>Cancelar</ChildContent>
            </BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmDeleteAsync">
                <ChildContent>Eliminar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@* ===== Detalles ===== *@
<BbDialog @bind-Open="_detailsOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@_detailsTarget?.Name</BbDialogTitle>
            <BbDialogDescription>Detalles del departamento.</BbDialogDescription>
        </BbDialogHeader>
        @if (_detailsTarget is not null)
        {
            <dl class="grid grid-cols-[170px_1fr] gap-x-4 gap-y-2 text-sm">
                <dt class="text-muted-foreground">Publicador responsable</dt>
                <dd>
                    @if (_detailsTarget.ResponsiblePublisher is not null)
                    {
                        <span class="inline-flex items-center gap-2">
                            <BbAvatar Size="AvatarSize.Small">
                                <BbAvatarFallback>@Initials(PublisherName(_detailsTarget.ResponsiblePublisher))</BbAvatarFallback>
                            </BbAvatar>
                            <span>@PublisherName(_detailsTarget.ResponsiblePublisher)</span>
                        </span>
                    }
                    else
                    {
                        <span class="text-muted-foreground">—</span>
                    }
                </dd>
                <dt class="text-muted-foreground">Responsabilidades</dt>
                <dd><EntityChips Items="@(_detailsTarget.Responsibilities?.Select(r => r.Name).ToList() ?? [])" Max="int.MaxValue"/></dd>
            </dl>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _detailsOpen = false)">
                <ChildContent>Cerrar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<Department> _departments = [];
    private List<Responsibility> _responsibilities = [];
    private SelectOption<Guid>[] _responsibilityOptions = [];
    private SelectOption<Guid?>[] _publisherOptions = [];

    private bool _formOpen;
    private bool _isNew;
    private Department _editing = new();
    private IEnumerable<Guid> _selectedResponsibilities = [];
    private string? _formError;

    private bool _deleteOpen;
    private Department? _deleteTarget;

    private bool _detailsOpen;
    private Department? _detailsTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _departments = (await DepartmentService.GetAllAsync()).ToList();
        _responsibilities = (await DepartmentService.GetAvailableResponsibilitiesAsync()).ToList();
        _responsibilityOptions = _responsibilities
            .Select(r => new SelectOption<Guid>(r.ResponsibilityId, r.Name)).ToArray();

        var publishers = await DepartmentService.GetAvailablePublishersAsync();
        _publisherOptions = publishers
            .Select(p => new SelectOption<Guid?>(p.PublisherId, PublisherName(p)))
            .OrderBy(o => o.Text)
            .ToArray();
    }

    private void OpenCreate()
    {
        _isNew = true;
        _editing = new Department { Name = string.Empty };
        _selectedResponsibilities = [];
        _formError = null;
        _formOpen = true;
    }

    private async Task OpenEdit(Department department)
    {
        _isNew = false;
        _editing = await DepartmentService.GetByIdAsync(department.DepartmentId) ?? new Department();
        _selectedResponsibilities = _editing.Responsibilities.Select(r => r.ResponsibilityId).ToList();
        _formError = null;
        _formOpen = true;
    }

    private async Task SaveAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _formError = "El nombre es obligatorio.";
            return;
        }

        try
        {
            if (_isNew)
            {
                await DepartmentService.AddAsync(_editing);
            }
            else
            {
                await DepartmentService.UpdateAsync(_editing);
            }

            await DepartmentService.UpdateDepartmentResponsibilitiesAsync(_editing.DepartmentId, _selectedResponsibilities);

            _formOpen = false;
            await LoadAsync();
        }
        catch
        {
            _formError = "No se pudo guardar el departamento.";
        }
    }

    private void OpenDelete(Department department)
    {
        _deleteTarget = department;
        _deleteOpen = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null)
        {
            return;
        }

        try
        {
            await DepartmentService.DeleteAsync(_deleteTarget.DepartmentId);
        }
        catch
        {
            // Ignored: reload shows the current state.
        }

        _deleteOpen = false;
        await LoadAsync();
    }

    private void OpenDetails(Department department)
    {
        _detailsTarget = department;
        _detailsOpen = true;
    }

    private static string PublisherName(Publisher publisher)
    {
        var name = publisher.FirstName;
        if (!string.IsNullOrEmpty(publisher.LastName)) name += $" {publisher.LastName}";
        if (!string.IsNullOrEmpty(publisher.MotherLastName)) name += $" {publisher.MotherLastName}";
        return name;
    }

    private static string Initials(string name)
    {
        name = name.Trim();
        return string.IsNullOrEmpty(name) ? "?" : (name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant());
    }
}

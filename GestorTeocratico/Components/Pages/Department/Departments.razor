@page "/departments"
@attribute [Authorize(Roles = "Admin, Manager")]
@implements IDisposable
@using System.Globalization
@using GestorTeocratico.Features.Common
@using GestorTeocratico.Features.Departments
@using BlazorBlueprint.Components
@using BlazorBlueprint.Primitives
@using BlazorBlueprint.Icons.Lucide.Components
@using ButtonSize = BlazorBlueprint.Components.ButtonSize

@inject GetDepartmentsHandler GetDepartments
@inject GetDepartmentByIdHandler GetDepartmentById
@inject GetDepartmentOptionsHandler GetDepartmentOptions
@inject CreateDepartmentHandler CreateDepartment
@inject UpdateDepartmentHandler UpdateDepartment
@inject DeleteDepartmentHandler DeleteDepartment

<PageTitle>Departamentos</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold tracking-tight">Departamentos</h1>
        <p class="text-sm text-muted-foreground">Departamentos, responsables y sus responsabilidades.</p>
    </div>

    <BbDataTable TData="DepartmentDto" Data="@_departments" InitialPageSize="10" AriaLabel="Departamentos">
        <ToolbarActions>
            <BbButton OnClick="OpenCreate">
                <Icon><LucideIcon Name="plus"/></Icon>
                <ChildContent>Agregar departamento</ChildContent>
            </BbButton>
        </ToolbarActions>
        <Columns>
            <BbDataTableColumn TData="DepartmentDto" TValue="string" Property="@(d => d.Name)"
                               Header="Nombre" Sortable="true" Filterable="true"/>
            <BbDataTableColumn TData="DepartmentDto" TValue="string" Header="Publicador responsable" Width="240px">
                <CellTemplate Context="d">
                    @if (d.ResponsiblePublisherName is not null)
                    {
                        <span class="inline-flex items-center gap-2">
                            <BbAvatar Size="AvatarSize.Small">
                                <BbAvatarFallback>@Initials(d.ResponsiblePublisherName)</BbAvatarFallback>
                            </BbAvatar>
                            <span class="truncate">@d.ResponsiblePublisherName</span>
                        </span>
                    }
                    else
                    {
                        <span class="text-muted-foreground">Sin asignar</span>
                    }
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="DepartmentDto" TValue="string" Header="Responsabilidades" Width="240px">
                <CellTemplate Context="d">
                    <EntityChips Items="@d.ResponsibilityNames" Max="int.MaxValue"/>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="DepartmentDto" TValue="string" Header="Acciones" Width="150px">
                <CellTemplate Context="d">
                    <div class="flex items-center gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Ver"
                                  OnClick="@(() => OpenDetails(d))">
                            <LucideIcon Name="eye" Class="size-4"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Editar"
                                  OnClick="@(() => OpenEdit(d))">
                            <LucideIcon Name="pencil" Class="size-4"/>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Eliminar"
                                  OnClick="@(() => OpenDelete(d))">
                            <LucideIcon Name="trash-2" Class="size-4 text-destructive"/>
                        </BbButton>
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>
</div>

@* ===== Formulario crear/editar ===== *@
<BbDialog @bind-Open="_formOpen">
    <BbDialogContent Class="sm:max-w-lg">
        <BbDialogHeader>
            <BbDialogTitle>@(_isNew ? "Agregar departamento" : "Editar departamento")</BbDialogTitle>
            <BbDialogDescription>Define el departamento y sus responsabilidades.</BbDialogDescription>
        </BbDialogHeader>

        @if (!string.IsNullOrEmpty(_formError))
        {
            <div class="rounded-md border border-destructive/30 bg-destructive/10 p-3 text-sm text-destructive">
                @_formError
            </div>
        }

        <EditForm Model="_editing" OnValidSubmit="SaveAsync" class="space-y-4">
            <div class="space-y-2">
                <BbLabel For="Name">Nombre *</BbLabel>
                <BbInput Id="Name" @bind-Value="_editing.Name" Placeholder="Nombre del departamento"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Publicador responsable</BbLabel>
                <BbCombobox TValue="Guid?" Options="_publisherOptions" SearchPlaceholder="Buscar publicador..."
                            @bind-Value="_editing.ResponsiblePublisherId" Placeholder="Sin asignar"/>
            </div>
            <div class="space-y-2">
                <BbLabel>Responsabilidades</BbLabel>
                <BbMultiSelect TValue="Guid" Options="_responsibilityOptions" MaxDisplayTags="5" SingleLine="true"
                               Values="_selectedResponsibilities" ValuesChanged="OnResponsibilitiesChanged" Placeholder="Selecciona responsabilidades"/>
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _formOpen = false)">
                    <ChildContent>Cancelar</ChildContent>
                </BbButton>
                <BbButton Type="BlazorBlueprint.Components.ButtonType.Submit">
                    <ChildContent>Guardar</ChildContent>
                </BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@* ===== Confirmar eliminación ===== *@
<BbDialog @bind-Open="_deleteOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>Eliminar departamento</BbDialogTitle>
            <BbDialogDescription>
                ¿Seguro que deseas eliminar <strong>@_deleteTarget?.Name</strong>? Esta acción no se puede deshacer.
            </BbDialogDescription>
        </BbDialogHeader>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _deleteOpen = false)">
                <ChildContent>Cancelar</ChildContent>
            </BbButton>
            <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmDeleteAsync">
                <ChildContent>Eliminar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@* ===== Detalles ===== *@
<BbDialog @bind-Open="_detailsOpen">
    <BbDialogContent Class="sm:max-w-md">
        <BbDialogHeader>
            <BbDialogTitle>@_detailsTarget?.Name</BbDialogTitle>
            <BbDialogDescription>Detalles del departamento.</BbDialogDescription>
        </BbDialogHeader>
        @if (_detailsTarget is not null)
        {
            <dl class="grid grid-cols-[170px_1fr] gap-x-4 gap-y-2 text-sm">
                <dt class="text-muted-foreground">Publicador responsable</dt>
                <dd>
                    @if (_detailsTarget.ResponsiblePublisherName is not null)
                    {
                        <span class="inline-flex items-center gap-2">
                            <BbAvatar Size="AvatarSize.Small">
                                <BbAvatarFallback>@Initials(_detailsTarget.ResponsiblePublisherName)</BbAvatarFallback>
                            </BbAvatar>
                            <span>@_detailsTarget.ResponsiblePublisherName</span>
                        </span>
                    }
                    else
                    {
                        <span class="text-muted-foreground">—</span>
                    }
                </dd>
                <dt class="text-muted-foreground">Responsabilidades</dt>
                <dd><EntityChips Items="@_detailsTarget.ResponsibilityNames" Max="int.MaxValue"/></dd>
            </dl>
        }
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _detailsOpen = false)">
                <ChildContent>Cerrar</ChildContent>
            </BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private List<DepartmentDto> _departments = [];
    private SelectOption<Guid>[] _responsibilityOptions = [];
    private SelectOption<Guid?>[] _publisherOptions = [];
    private readonly CancellationTokenSource _cts = new();

    private bool _formOpen;
    private bool _isNew;
    private DepartmentFormModel _editing = new();
    private IEnumerable<Guid> _selectedResponsibilities = [];
    private string? _formError;

    private bool _deleteOpen;
    private DepartmentDto? _deleteTarget;

    private bool _detailsOpen;
    private DepartmentDto? _detailsTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task LoadAsync()
    {
        try
        {
            _departments = (await GetDepartments.HandleAsync(_cts.Token)).ToList();

            var options = await GetDepartmentOptions.HandleAsync(_cts.Token);
            _responsibilityOptions = options.Responsibilities
                .Select(r => new SelectOption<Guid>(r.Id, r.Name))
                .OrderBy(o => o.Text, NameComparer).ToArray();
            _publisherOptions = options.Publishers
                .Select(p => new SelectOption<Guid?>(p.Id, p.Name))
                .OrderBy(o => o.Text, NameComparer)
                .ToArray();
        }
        catch (OperationCanceledException)
        {
            // The component was disposed while loading.
        }
    }

    private void OpenCreate()
    {
        _isNew = true;
        _editing = new DepartmentFormModel { Name = string.Empty };
        _selectedResponsibilities = [];
        _formError = null;
        _formOpen = true;
    }

    private async Task OpenEdit(DepartmentDto department)
    {
        _isNew = false;
        var dto = await GetDepartmentById.HandleAsync(department.Id);
        _editing = MapToForm(dto);
        _selectedResponsibilities = SortByOptionText(dto?.ResponsibilityIds ?? [], _responsibilityOptions);
        _formError = null;
        _formOpen = true;
    }

    private static DepartmentFormModel MapToForm(DepartmentDto? dto) => dto is null
        ? new DepartmentFormModel()
        : new DepartmentFormModel
        {
            Id = dto.Id,
            Name = dto.Name,
            ResponsiblePublisherId = dto.ResponsiblePublisherId
        };

    private async Task SaveAsync()
    {
        _formError = null;

        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _formError = "El nombre es obligatorio.";
            return;
        }

        var responsibilityIds = _selectedResponsibilities.ToArray();

        try
        {
            if (_isNew)
            {
                await CreateDepartment.HandleAsync(new CreateDepartmentCommand(
                    _editing.Name,
                    _editing.ResponsiblePublisherId,
                    responsibilityIds));
            }
            else
            {
                await UpdateDepartment.HandleAsync(new UpdateDepartmentCommand(
                    _editing.Id,
                    _editing.Name,
                    _editing.ResponsiblePublisherId,
                    responsibilityIds));
            }

            _formOpen = false;
            await LoadAsync();
        }
        catch (DuplicateEntityException ex)
        {
            _formError = ex.Message;
        }
        catch
        {
            _formError = "No se pudo guardar el departamento.";
        }
    }

    private void OpenDelete(DepartmentDto department)
    {
        _deleteTarget = department;
        _deleteOpen = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteTarget is null)
        {
            return;
        }

        try
        {
            await DeleteDepartment.HandleAsync(_deleteTarget.Id);
        }
        catch
        {
            // Ignored: reload shows the current state.
        }

        _deleteOpen = false;
        await LoadAsync();
    }

    private void OpenDetails(DepartmentDto department)
    {
        _detailsTarget = department;
        _detailsOpen = true;
    }

    private void OnResponsibilitiesChanged(IEnumerable<Guid>? values) =>
        _selectedResponsibilities = SortByOptionText(values, _responsibilityOptions);

    private static IEnumerable<Guid> SortByOptionText(IEnumerable<Guid>? ids, IEnumerable<SelectOption<Guid>> options)
    {
        if (ids is null)
        {
            return [];
        }

        var order = options.ToDictionary(o => o.Value, o => o.Text);
        return ids.OrderBy(id => order.TryGetValue(id, out var text) ? text : string.Empty, NameComparer).ToList();
    }

    private static readonly StringComparer NameComparer =
        StringComparer.Create(CultureInfo.GetCultureInfo("es-ES"), true);

    private static string Initials(string name)
    {
        name = name.Trim();
        return string.IsNullOrEmpty(name) ? "?" : (name.Length >= 2 ? name[..2].ToUpperInvariant() : name.ToUpperInvariant());
    }
}

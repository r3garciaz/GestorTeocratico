@using BlazorBlueprint.Components
@using BlazorBlueprint.Icons.Lucide.Components
@using Microsoft.AspNetCore.Components.Routing

@*
    Navegación del shell (Blazor Blueprint). El estado activo se deriva de la URL
    automáticamente en BbSidebarMenuButton (Href + Match).
*@

<BbSidebarGroup>
    <BbSidebarGroupLabel>General</BbSidebarGroupLabel>
    <BbSidebarGroupContent>
        <BbSidebarMenu>
            <BbSidebarMenuItem>
                <BbSidebarMenuButton Href="/dashboard" Match="NavLinkMatch.All" Tooltip="Inicio">
                    <LucideIcon Name="house"/>
                    <span>Inicio</span>
                </BbSidebarMenuButton>
            </BbSidebarMenuItem>
        </BbSidebarMenu>
    </BbSidebarGroupContent>
</BbSidebarGroup>

<AuthorizeView Roles="@($"{Shared.Roles.Admin}, {Shared.Roles.Manager}")">
    <Authorized>
        <BbSidebarGroup>
            <BbSidebarGroupLabel>Configuración</BbSidebarGroupLabel>
            <BbSidebarGroupContent>
                <BbSidebarMenu>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/congregations" Tooltip="Congregación">
                            <LucideIcon Name="church"/>
                            <span>Congregación</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/departments" Tooltip="Departamentos">
                            <LucideIcon Name="building-2"/>
                            <span>Departamentos</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/responsibilities" Tooltip="Responsabilidades">
                            <LucideIcon Name="clipboard-list"/>
                            <span>Responsabilidades</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/publishers" Tooltip="Publicadores">
                            <LucideIcon Name="users"/>
                            <span>Publicadores</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                </BbSidebarMenu>
            </BbSidebarGroupContent>
        </BbSidebarGroup>

        <BbSidebarGroup>
            <BbSidebarGroupLabel>Reuniones</BbSidebarGroupLabel>
            <BbSidebarGroupContent>
                <BbSidebarMenu>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/meeting-schedules" Tooltip="Programación de reuniones">
                            <LucideIcon Name="calendar-days"/>
                            <span>Programación</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                </BbSidebarMenu>
            </BbSidebarGroupContent>
        </BbSidebarGroup>

        <BbSidebarGroup>
            <BbSidebarGroupLabel>Administración</BbSidebarGroupLabel>
            <BbSidebarGroupContent>
                <BbSidebarMenu>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/administration/users" Tooltip="Usuarios">
                            <LucideIcon Name="user-cog"/>
                            <span>Usuarios</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/administration/roles" Tooltip="Roles">
                            <LucideIcon Name="shield"/>
                            <span>Roles</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                </BbSidebarMenu>
            </BbSidebarGroupContent>
        </BbSidebarGroup>
    </Authorized>
</AuthorizeView>

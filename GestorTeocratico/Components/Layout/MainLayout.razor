@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using GestorTeocratico.Components.Account

<BbSidebarProvider DefaultOpen="true" HeightClass="h-svh overflow-hidden">
    <BbSidebar>
        <BbSidebarHeader>
            <BbSidebarHeaderContent>
                <div class="flex size-8 items-center justify-center rounded-lg bg-primary/10 text-primary">
                    <LucideIcon Name="book-open" Class="size-5"/>
                </div>
                <BbSidebarHeaderInfo>
                    <span class="truncate font-semibold">Gestor Teocrático</span>
                    <span class="truncate text-xs text-muted-foreground">Congregación</span>
                </BbSidebarHeaderInfo>
            </BbSidebarHeaderContent>
        </BbSidebarHeader>

        <BbSidebarContent>
            <NavMenu/>
        </BbSidebarContent>

        <BbSidebarFooter>
            <BbDropdownMenu>
                <BbDropdownMenuTrigger AsChild="true">
                    <BbButton Variant="ButtonVariant.Ghost" Class="h-12 w-full justify-start gap-2 px-2">
                        <BbAvatar Size="AvatarSize.Small">
                            <BbAvatarFallback>@Initials</BbAvatarFallback>
                        </BbAvatar>
                        <div class="flex min-w-0 flex-1 flex-col items-start text-left">
                            <span class="truncate text-sm font-medium">@DisplayName</span>
                            <span class="truncate text-xs text-muted-foreground">@Email</span>
                        </div>
                        <LucideIcon Name="chevrons-up-down" Class="size-4 text-muted-foreground"/>
                    </BbButton>
                </BbDropdownMenuTrigger>
                <BbDropdownMenuContent Side="PopoverSide.Top" Align="PopoverAlign.Start" MatchTriggerWidth="true">
                    <div class="flex items-center gap-2 p-2">
                        <BbAvatar Size="AvatarSize.Small">
                            <BbAvatarFallback>@Initials</BbAvatarFallback>
                        </BbAvatar>
                        <div class="flex min-w-0 flex-col">
                            <span class="truncate text-sm font-medium">@DisplayName</span>
                            <span class="truncate text-xs text-muted-foreground">@Email</span>
                        </div>
                    </div>
                    <BbDropdownMenuSeparator/>
                    <BbDropdownMenuItem Href="/Account/Manage">
                        <LucideIcon Name="user" Class="mr-2 size-4"/>
                        Mi cuenta
                    </BbDropdownMenuItem>
                    <BbDropdownMenuSeparator/>
                    <form method="post" action="Account/Logout">
                        <AntiforgeryToken/>
                        <input type="hidden" name="returnUrl" value="/"/>
                        <BbButton Type="BlazorBlueprint.Components.ButtonType.Submit" Variant="ButtonVariant.Ghost"
                                  Class="w-full justify-start text-destructive">
                            <Icon><LucideIcon Name="log-out"/></Icon>
                            <ChildContent>Cerrar sesión</ChildContent>
                        </BbButton>
                    </form>
                </BbDropdownMenuContent>
            </BbDropdownMenu>
        </BbSidebarFooter>

        <BbSidebarRail/>
    </BbSidebar>

    <BbSidebarInset Class="min-w-0">
        <header class="flex h-16 shrink-0 items-center gap-2 border-b px-4">
            <BbSidebarTrigger/>
            <span class="text-sm font-medium">@PageTitle</span>
            <div class="ml-auto flex items-center gap-1">
                <BbThemeSwitcher Variant="ButtonVariant.Ghost" ShowDesignOptions="true"/>
                <BbDarkModeToggle Variant="ButtonVariant.Ghost"/>
            </div>
        </header>

        <div class="min-w-0 min-h-0 flex-1 overflow-y-auto p-4 lg:p-6">
            @Body
        </div>

        <footer class="border-t px-4 py-3 text-xs text-muted-foreground">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="inline-flex items-center gap-1.5">
                    <LucideIcon Name="shield-check" Class="size-3.5 text-primary"/>
                    @if (!string.IsNullOrEmpty(PublicId))
                    {
                        <span>ID público: @PublicId</span>
                    }
                    else if (_user is not null)
                    {
                        <span>ID público no disponible</span>
                    }
                    else
                    {
                        <span>Usuario no autenticado</span>
                    }
                </span>
                <span>Gestor Teocrático © @DateTime.Now.Year</span>
            </div>
        </footer>
    </BbSidebarInset>
</BbSidebarProvider>

@* Providers de Blazor Blueprint. Se renderizan en el mismo scope interactivo que
   el contenido (la interactividad se aplica en <Routes>). *@
<BbPortalHost/>
<BbToastProvider/>
<BbDialogProvider/>

@code {
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private ClaimsPrincipal? _user;
    private string _pageTitle = "Gestor Teocrático";

    private string PageTitle => _pageTitle;

    private string DisplayName => _user?.Identity?.Name ?? "Usuario";

    private string? Email => _user?.FindFirst(ClaimTypes.Email)?.Value;

    private string PublicId =>
        _user?.FindFirst(ApplicationUserClaimsPrincipalFactory.PublicIdClaim)?.Value ?? "";

    private string Initials
    {
        get
        {
            var source = DisplayName.Trim();
            if (string.IsNullOrEmpty(source))
            {
                return "?";
            }

            return source.Length >= 2 ? source[..2].ToUpperInvariant() : source.ToUpperInvariant();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _user = authState.User.Identity?.IsAuthenticated == true ? authState.User : null;

        UpdateTitle(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateTitle(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateTitle(string uri)
    {
        var relative = NavigationManager.ToBaseRelativePath(uri).Split('?')[0].TrimEnd('/');

        _pageTitle = relative switch
        {
            "" or "dashboard" => "Inicio",
            "congregations" => "Congregaciones",
            "departments" => "Departamentos",
            "responsibilities" => "Responsabilidades",
            "publishers" => "Publicadores",
            "meeting-schedules" => "Programación de reuniones",
            _ when relative.StartsWith("administration") => "Administración",
            _ when relative.StartsWith("Account") => "Mi cuenta",
            _ => "Gestor Teocrático"
        };
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

@inject NavigationManager NavigationManager
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Gestor Teocrático</title>
    <base href="@NavigationManager.BaseUri" />
    <ResourcePreloader/>
    <link rel="stylesheet" href="@Assets["GestorTeocratico.styles.css"]"/>

    <!-- Blazor Blueprint -->
    <!-- 1. Tema (variables CSS). Debe cargar antes de blazorblueprint.css. -->
    <link rel="stylesheet" href="styles/themes/default.css"/>
    <!-- 2. Estilos de los componentes Blazor Blueprint. -->
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css"/>
    <!-- 3. Paletas base/primary para BbThemeSwitcher. -->
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/css/themes.css"/>
    <!-- 4. Tailwind propio del proyecto (utilidades de página). -->
    <link rel="stylesheet" href="css/app.css"/>
    <!-- 5. Aplica el tema guardado antes del primer paint (script clásico, sin defer). -->
    <script src="_content/BlazorBlueprint.Components/js/theme-init.js"></script>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal/>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; }

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
